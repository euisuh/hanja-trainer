{
  "name": "hanja-trainer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build",
    "dev": "wrangler dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:colors": "node scripts/check-colors.mjs",
    "test": "node --test scripts/*.test.mjs && node --import tsx --test scripts/*.test.ts && vitest run",
    "e2e:prepare": "node scripts/e2e-setup.mjs",
    "e2e": "playwright test",
    "e2e:ci": "node scripts/e2e-ci.mjs",
    "sentences:readings": "node scripts/generate-sentence-readings.mjs",
    "preseed:local": "npm run sentences:readings",
    "seed:local": "tsx scripts/seed.ts --local data/characters/*.json data/sentences/*.json data/words/*.json data/conversation/unit-*.json",
    "preseed:remote": "npm run sentences:readings",
    "seed:remote": "tsx scripts/seed.ts --remote data/characters/*.json data/sentences/*.json data/words/*.json data/conversation/unit-*.json",
    "validate:conversation": "node --import tsx scripts/validate-conversation.ts",
    "verify:conversation": "npm run validate:conversation -- --verify-remote",
    "review:authored": "node --import tsx scripts/review-authored.ts",
    "audio:generate": "tsx scripts/generate-audio.ts --remote data/characters/*.json",
    "audio:generate:conv": "tsx scripts/generate-audio.ts --conversation --remote data/conversation/unit-*.json",
    "deploy": "npm run build && wrangler deploy",
    "build:mobile": "VITE_API_ORIGIN=https://hanja.uiseoya.com vite build && cap sync",
    "android": "npm run build:mobile && cap open android",
    "ios": "npm run build:mobile && cap open ios",
    "lint:slop": "NODE_NO_WARNINGS=1 oxlint -c oxlint.config.ts",
    "lint:slop:changed": "node tools/oxlint/changed.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/preferences": "8.0.1",
    "@fontsource-variable/noto-sans-kr": "5.3.0",
    "@fontsource-variable/noto-serif-jp": "5.3.0",
    "@fontsource-variable/noto-serif-kr": "5.3.0",
    "@fontsource-variable/noto-serif-sc": "5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "ts-fsrs": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@eslint/js": "^10.0.1",
    "@oxlint/plugins": "1.78.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^31.0.0",
    "kuroshiro": "^1.2.0",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "oxlint": "1.78.0",
    "pinyin-pro": "^3.29.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "unbzip2-stream": "^1.4.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.11",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "sharp": "0.35.4",
    "uuid": "11.1.1"
  }
}
