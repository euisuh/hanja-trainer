{
  "name": "hanja-trainer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build",
    "dev": "wrangler dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:colors": "node scripts/check-colors.mjs",
    "test": "node --import tsx --test scripts/*.test.ts && vitest run src/shared/fsrs.test.ts src/features/session/buildQueue.test.ts src/features/review/DueList.test.ts src/features/placement/adaptive.test.ts src/features/path-map/homeModel.test.ts src/features/detail/detailModel.test.ts src/features/stats/calendar.test.ts src/features/stats/levelProgress.test.ts src/features/settings/settings.test.ts worker/db/reviews.test.ts worker/api/content.test.ts worker/api/reviews.test.ts worker/api/placement.test.ts",
    "e2e:prepare": "node scripts/e2e-setup.mjs",
    "e2e": "playwright test",
    "seed:local": "tsx scripts/seed.ts --local data/characters/*.json data/sentences/*.json",
    "seed:remote": "tsx scripts/seed.ts --remote data/characters/*.json data/sentences/*.json",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "ts-fsrs": "^5.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.0"
  }
}
