{
  "sentences": [
    {
      "character_key": "一",
      "track": "jp",
      "text": "私は一番です。",
      "translation_ko": "제가 최고입니다.",
      "source": "Tatoeba #13537076",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "わたしはいちばんです。"
    },
    {
      "character_key": "二",
      "track": "jp",
      "text": "息子が二人います。",
      "translation_ko": "나에게는 아들이 둘 있다.",
      "source": "Tatoeba #9159325",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "むすこがふたりいます。"
    },
    {
      "character_key": "九",
      "track": "jp",
      "text": "もう九時です。",
      "translation_ko": "벌써 아홉시다.",
      "source": "Tatoeba #1483516",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "もうくじです。"
    },
    {
      "character_key": "七",
      "track": "jp",
      "text": "七歳です。",
      "translation_ko": "일곱 살이에요.",
      "source": "Tatoeba #13128674",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "ななさいです。"
    },
    {
      "character_key": "人",
      "track": "jp",
      "text": "韓国人です。",
      "translation_ko": "한국 사람입니다.",
      "source": "Tatoeba #8692860",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "かんこくじんです。"
    },
    {
      "character_key": "入",
      "track": "jp",
      "text": "恐れ入ります。",
      "translation_ko": "죄송합니다",
      "source": "Tatoeba #13117392",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "おそれいります。"
    },
    {
      "character_key": "八",
      "track": "jp",
      "text": "八十歳です。",
      "translation_ko": "여든이세요.",
      "source": "Tatoeba #13225054",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "はちじゅっさいです。"
    },
    {
      "character_key": "力",
      "track": "jp",
      "text": "全力を尽くします。",
      "translation_ko": "최선을 다하겠습니다.",
      "source": "Tatoeba #140736",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "ぜんりょくをつくします。"
    },
    {
      "character_key": "十",
      "track": "jp",
      "text": "八十歳です。",
      "translation_ko": "여든이세요.",
      "source": "Tatoeba #13225054",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "はちじゅっさいです。"
    },
    {
      "character_key": "三",
      "track": "jp",
      "text": "トムは子供が三人います。",
      "translation_ko": "톰은 애들이 3명 있다.",
      "source": "Tatoeba #2177588",
      "source_kind": "corpus",
      "target_index": 6,
      "rank": 0,
      "reading": "とむはこどもがさんにんいます。"
    },
    {
      "character_key": "上",
      "track": "jp",
      "text": "彼は泳ぎが上手です。",
      "translation_ko": "그는 수영을 잘 한다.",
      "source": "Tatoeba #109766",
      "source_kind": "corpus",
      "target_index": 5,
      "rank": 0,
      "reading": "かれはおよぎがじょうずです。"
    },
    {
      "character_key": "下",
      "track": "jp",
      "text": "手伝って下さいますか。",
      "translation_ko": "저를 좀 도와 주실래요?",
      "source": "Tatoeba #148494",
      "source_kind": "corpus",
      "target_index": 4,
      "rank": 0,
      "reading": "てつだってくださいますか。"
    },
    {
      "character_key": "口",
      "track": "jp",
      "text": "出口はどこですか？",
      "translation_ko": "출구는 어디예요?",
      "source": "Tatoeba #3549611",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "でぐちはどこですか？"
    },
    {
      "character_key": "大",
      "track": "jp",
      "text": "大学生です。",
      "translation_ko": "저는 학생입니다.",
      "source": "Tatoeba #137609",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "だいがくせいです。"
    },
    {
      "character_key": "女",
      "track": "jp",
      "text": "彼女は医者です。",
      "translation_ko": "그는 의사예요.",
      "source": "Tatoeba #93769",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "かのじょはいしゃです。"
    },
    {
      "character_key": "山",
      "track": "jp",
      "text": "その山は緑です。",
      "translation_ko": "산이 파랗습니다.",
      "source": "Tatoeba #963704",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "そのやまはみどりです。"
    },
    {
      "character_key": "川",
      "track": "jp",
      "text": "世界で一番長い川は何ですか。",
      "translation_ko": "세계의 가장 긴 강의 이름이 뭐지?",
      "source": "Tatoeba #143455",
      "source_kind": "corpus",
      "target_index": 7,
      "rank": 0,
      "reading": "せかいでいちばんながいかわはなんですか。"
    },
    {
      "character_key": "土",
      "track": "jp",
      "text": "あれは土星です。",
      "translation_ko": "저것은 토성이에요.",
      "source": "Tatoeba #13541131",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "あれはどせいです。"
    },
    {
      "character_key": "千",
      "track": "jp",
      "text": "千葉県の県庁所在地は千葉市です。",
      "translation_ko": "치바현의 현청 소재지는 치바시입니다.",
      "source": "Tatoeba #10999281",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "ちばけんのけんちょうしょざいちはちばしです。"
    },
    {
      "character_key": "夕",
      "track": "jp",
      "text": "もう夕食は済みましたか。",
      "translation_ko": "아직 저녁을 안 드셨나요?",
      "source": "Tatoeba #193974",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "もうゆうしょくはすみましたか。"
    },
    {
      "character_key": "子",
      "track": "jp",
      "text": "息子です。",
      "translation_ko": "내 아들이에요.",
      "source": "Tatoeba #4562142",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "むすこです。"
    },
    {
      "character_key": "小",
      "track": "jp",
      "text": "地球は太陽より小さいです。",
      "translation_ko": "지구는 태양보다 작아요.",
      "source": "Tatoeba #13541588",
      "source_kind": "corpus",
      "target_index": 7,
      "rank": 0,
      "reading": "ちきゅうはたいようよりちいさいです。"
    },
    {
      "character_key": "中",
      "track": "jp",
      "text": "仕事中です。",
      "translation_ko": "나는 일하는 중이다.",
      "source": "Tatoeba #1046221",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "しごとちゅうです。"
    },
    {
      "character_key": "五",
      "track": "jp",
      "text": "五ヶ国語話します。",
      "translation_ko": "저는 다섯 개의 언어를 합니다.",
      "source": "Tatoeba #3804584",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "ごかこくごはなします。"
    },
    {
      "character_key": "六",
      "track": "jp",
      "text": "十六歳ですよ。",
      "translation_ko": "나는 열여섯 살입니다.",
      "source": "Tatoeba #8865844",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "じゅうろくさいですよ。"
    },
    {
      "character_key": "圓",
      "track": "jp",
      "text": "私は高円寺に住んでいました。",
      "translation_ko": "저는 코엔지에서 살았습니다.",
      "source": "Tatoeba #2386330",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "わたしはこうえんじにすんでいました。"
    },
    {
      "character_key": "天",
      "track": "jp",
      "text": "天気は暑いです。",
      "translation_ko": "날씨가 더워요.",
      "source": "Tatoeba #9101664",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "てんきはあついです。"
    },
    {
      "character_key": "手",
      "track": "jp",
      "text": "手遅れですか？",
      "translation_ko": "너무 늦었나요?",
      "source": "Tatoeba #11625244",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "ておくれですか？"
    },
    {
      "character_key": "文",
      "track": "jp",
      "text": "文章を書いています。",
      "translation_ko": "문장을 쓰고 있어요.",
      "source": "Tatoeba #13184941",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "ぶんしょうをかいています。"
    },
    {
      "character_key": "日",
      "track": "jp",
      "text": "月曜日です。",
      "translation_ko": "오늘은 월요일입니다.",
      "source": "Tatoeba #175603",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "げつようびです。"
    },
    {
      "character_key": "月",
      "track": "jp",
      "text": "12月です。",
      "translation_ko": "12월입니다.",
      "source": "Tatoeba #11303233",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "じゅうにがつです。"
    },
    {
      "character_key": "木",
      "track": "jp",
      "text": "木は緑色です。",
      "translation_ko": "나무는 초록색이에요.",
      "source": "Tatoeba #13541053",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "きはみどりいろです。"
    },
    {
      "character_key": "水",
      "track": "jp",
      "text": "今日は水曜日です。",
      "translation_ko": "오늘은 수요일입니다.",
      "source": "Tatoeba #1458037",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "きょうはすいようびです。"
    },
    {
      "character_key": "火",
      "track": "jp",
      "text": "火狐使いです。",
      "translation_ko": "나는 파이어폭스를 사용해.",
      "source": "Tatoeba #1048480",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "ひぎつねつかいです。"
    },
    {
      "character_key": "犬",
      "track": "jp",
      "text": "これは私の犬です。",
      "translation_ko": "이것은 내 개입니다.",
      "source": "Tatoeba #13535097",
      "source_kind": "corpus",
      "target_index": 5,
      "rank": 0,
      "reading": "これはわたしのいぬです。"
    },
    {
      "character_key": "王",
      "track": "jp",
      "text": "苗字は王です。",
      "translation_ko": "성은 왕이에요.",
      "source": "Tatoeba #13198953",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "みょうじはおうです。"
    },
    {
      "character_key": "出",
      "track": "jp",
      "text": "咳が出ますか。",
      "translation_ko": "기침이 나옵니까?",
      "source": "Tatoeba #184712",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "せきがでますか。"
    },
    {
      "character_key": "右",
      "track": "jp",
      "text": "僕は右利きです。",
      "translation_ko": "나는 오른손잡이다.",
      "source": "Tatoeba #6207168",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "ぼくはみぎききです。"
    },
    {
      "character_key": "四",
      "track": "jp",
      "text": "二かける七は十四です。",
      "translation_ko": "2 곱하기 7의 결과는 14이다.",
      "source": "Tatoeba #3454067",
      "source_kind": "corpus",
      "target_index": 7,
      "rank": 0,
      "reading": "にかけるななはじゅうよんです。"
    },
    {
      "character_key": "左",
      "track": "jp",
      "text": "左に曲がって。",
      "translation_ko": "좌회전해.",
      "source": "Tatoeba #5253128",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "ひだりにまがって。"
    },
    {
      "character_key": "本",
      "track": "jp",
      "text": "本当ですか。",
      "translation_ko": "정말이에요?",
      "source": "Tatoeba #1585501",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "ほんとうですか。"
    },
    {
      "character_key": "正",
      "track": "jp",
      "text": "正気ですか。",
      "translation_ko": "미쳤어요?",
      "source": "Tatoeba #142962",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "しょうきですか。"
    },
    {
      "character_key": "玉",
      "track": "jp",
      "text": "玉ねぎはじゃが芋よりも火が通りやすい。",
      "translation_ko": "양파는 감자보다 빨리 익는다.",
      "source": "Tatoeba #10107038",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "たまねぎはじゃがいもよりもひがとおりやすい。"
    },
    {
      "character_key": "田",
      "track": "jp",
      "text": "田舎に住んでいます。",
      "translation_ko": "나는 시골에 산다.",
      "source": "Tatoeba #124907",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "いなかにすんでいます。"
    },
    {
      "character_key": "白",
      "track": "jp",
      "text": "この犬は白いです。",
      "translation_ko": "이 개는 흰색이에요.",
      "source": "Tatoeba #738246",
      "source_kind": "corpus",
      "target_index": 4,
      "rank": 0,
      "reading": "このいぬはしろいです。"
    },
    {
      "character_key": "目",
      "track": "jp",
      "text": "駄目です。",
      "translation_ko": "안 돼요.",
      "source": "Tatoeba #10901725",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "だめです。"
    },
    {
      "character_key": "石",
      "track": "jp",
      "text": "一石二鳥。",
      "translation_ko": "일석이조",
      "source": "Tatoeba #190377",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "いっせきにちょう。"
    },
    {
      "character_key": "立",
      "track": "jp",
      "text": "今、立て込んでます。",
      "translation_ko": "지금 바빠요.",
      "source": "Tatoeba #10618205",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "いま、たてこんでます。"
    },
    {
      "character_key": "休",
      "track": "jp",
      "text": "彼は今日お休みです。",
      "translation_ko": "그는 오늘 쉽니다.",
      "source": "Tatoeba #107098",
      "source_kind": "corpus",
      "target_index": 5,
      "rank": 0,
      "reading": "かれはきょうおやすみです。"
    },
    {
      "character_key": "先",
      "track": "jp",
      "text": "先生です。",
      "translation_ko": "그녀는 선생님입니다.",
      "source": "Tatoeba #13536216",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "せんせいです。"
    },
    {
      "character_key": "名",
      "track": "jp",
      "text": "名案です。",
      "translation_ko": "그것은 좋은 생각이야!",
      "source": "Tatoeba #9703324",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "めいあんです。"
    },
    {
      "character_key": "字",
      "track": "jp",
      "text": "苗字は王です。",
      "translation_ko": "성은 왕이에요.",
      "source": "Tatoeba #13198953",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "みょうじはおうです。"
    },
    {
      "character_key": "年",
      "track": "jp",
      "text": "ユリは多年草です。",
      "translation_ko": "백합은 여러해살이 식물이야.",
      "source": "Tatoeba #10650875",
      "source_kind": "corpus",
      "target_index": 4,
      "rank": 0,
      "reading": "ゆりはたねんそうです。"
    },
    {
      "character_key": "早",
      "track": "jp",
      "text": "祖父は朝が早いんですよ。",
      "translation_ko": "할아버지는 아침 일찍 일어나셔요.",
      "source": "Tatoeba #10763905",
      "source_kind": "corpus",
      "target_index": 5,
      "rank": 0,
      "reading": "そふはあさがはやいんですよ。"
    },
    {
      "character_key": "氣",
      "track": "jp",
      "text": "元気です。",
      "translation_ko": "잘 지내요.",
      "source": "Tatoeba #3495032",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "げんきです。"
    },
    {
      "character_key": "百",
      "track": "jp",
      "text": "百合は宿根草です。",
      "translation_ko": "백합은 여러해살이 식물이야.",
      "source": "Tatoeba #10650876",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "ゆりはしゅっこんそうです。"
    },
    {
      "character_key": "竹",
      "track": "jp",
      "text": "新竹は風が強いため、「風の街」という美称がある。",
      "translation_ko": "신주는 바람이 매우 강해서 \"바람의 도시\"라는 아름다운 별명이 있다.",
      "source": "Tatoeba #13545832",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "しんちくはかぜがつよいため、「かぜのまち」というびしょうがある。"
    },
    {
      "character_key": "耳",
      "track": "jp",
      "text": "耳が聞こえないんですか？",
      "translation_ko": "귀가 안 들리시나요?",
      "source": "Tatoeba #8688719",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "みみがきこえないんですか？"
    },
    {
      "character_key": "蟲",
      "track": "jp",
      "text": "クモが昆虫でないというのはよく知られた事実だ。",
      "translation_ko": "거미가 곤충이 아니라는 것은 잘 알려진 사실이야.",
      "source": "Tatoeba #982235",
      "source_kind": "corpus",
      "target_index": 4,
      "rank": 0,
      "reading": "くもがこんちゅうでないというのはよくしられたじじつだ。"
    },
    {
      "character_key": "村",
      "track": "jp",
      "text": "私の兄は、小さな村に住んでいます。",
      "translation_ko": "내 동생은 한 작은 마을에 살고 있어.",
      "source": "Tatoeba #163823",
      "source_kind": "corpus",
      "target_index": 8,
      "rank": 0,
      "reading": "わたしのあには、ちいさなむらにすんでいます。"
    },
    {
      "character_key": "男",
