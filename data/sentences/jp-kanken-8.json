{
  "sentences": [
    {
      "character_key": "拾",
      "track": "jp",
      "text": "貝殻を拾いながら、波打ち際を歩いた。",
      "translation_ko": "조개껍데기를 주우면서 물가를 걸었다.",
      "source": "Tatoeba #13146683",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "かいがらをひろいながら、なみうちぎわをあるいた。"
    },
    {
      "character_key": "開",
      "track": "jp",
      "text": "店は9時開店です。",
      "translation_ko": "가게는 9시 오픈입니다.",
      "source": "Tatoeba #11957970",
      "source_kind": "corpus",
      "target_index": 4,
      "rank": 0,
      "reading": "みせはくじかいてんです。"
    },
    {
      "character_key": "終",
      "track": "jp",
      "text": "時間終了。",
      "translation_ko": "시간이 흘렀다.",
      "source": "Tatoeba #3491506",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "じかんしゅうりょう。"
    },
    {
      "character_key": "始",
      "track": "jp",
      "text": "８時半に学校は始まる。",
      "translation_ko": "8시 반에 학교가 시작된다.",
      "source": "Tatoeba #9229993",
      "source_kind": "corpus",
      "target_index": 7,
      "rank": 0,
      "reading": "はちじはんにがっこうははじまる。"
    },
    {
      "character_key": "飲",
      "track": "jp",
      "text": "緑茶飲む？",
      "translation_ko": "당신은 녹차를 마셔요?",
      "source": "Tatoeba #2860783",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "りょくちゃのむ？"
    },
    {
      "character_key": "勉",
      "track": "jp",
      "text": "勉強する。",
      "translation_ko": "공부해요.",
      "source": "Tatoeba #4589949",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "べんきょうする。"
    },
    {
      "character_key": "商",
      "track": "jp",
      "text": "彼は商才にたけている。",
      "translation_ko": "그는 상재가 뛰어나다.",
      "source": "Tatoeba #104197",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "かれはしょうさいにたけている。"
    },
    {
      "character_key": "勝",
      "track": "jp",
      "text": "楽勝だよ。",
      "translation_ko": "껌이다.",
      "source": "Tatoeba #184131",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "らくしょうだよ。"
    },
    {
      "character_key": "待",
      "track": "jp",
      "text": "少し待ってて。",
      "translation_ko": "잠깐만요.",
      "source": "Tatoeba #10608937",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "すこしまってて。"
    },
    {
      "character_key": "取",
      "track": "jp",
      "text": "書き取れ！",
      "translation_ko": "적어 놔라!",
      "source": "Tatoeba #11784934",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "かきとれ！"
    },
    {
      "character_key": "曲",
      "track": "jp",
      "text": "左に曲がって。",
      "translation_ko": "좌회전해.",
      "source": "Tatoeba #5253128",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "ひだりにまがって。"
    },
    {
      "character_key": "具",
      "track": "jp",
      "text": "具合はどう？",
      "translation_ko": "느낌이 어때?",
      "source": "Tatoeba #10725058",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "ぐあいはどう？"
    },
    {
      "character_key": "宿",
      "track": "jp",
      "text": "百合は宿根草です。",
      "translation_ko": "백합은 여러해살이 식물이야.",
      "source": "Tatoeba #10650876",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "ゆりはしゅっこんそうです。"
    },
    {
      "character_key": "問",
      "track": "jp",
      "text": "それは死活問題だ。",
      "translation_ko": "삶과 죽음의 문제다.",
      "source": "Tatoeba #3459012",
      "source_kind": "corpus",
      "target_index": 5,
      "rank": 0,
      "reading": "それはしかつもんだいだ。"
    },
    {
      "character_key": "葉",
      "track": "jp",
      "text": "葉が黄色くなった。",
      "translation_ko": "나뭇잎이 노랗게 변했어요.",
      "source": "Tatoeba #13540174",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "はがきいろくなった。"
    },
    {
      "character_key": "島",
      "track": "jp",
      "text": "海には島がある。",
      "translation_ko": "바다에는 섬이 있다.",
      "source": "Tatoeba #9819836",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "うみにはしまがある。"
    },
    {
      "character_key": "等",
      "track": "jp",
      "text": "３角形のすべての角の和は１８０度に等しい。",
      "translation_ko": "삼각형에 있는 모든 각도의 합은 180도야.",
      "source": "Tatoeba #235339",
      "source_kind": "corpus",
      "target_index": 17,
      "rank": 0,
      "reading": "さんかくけいのすべてのかくのわはひゃくはちじゅうどにひとしい。"
    },
    {
      "character_key": "部",
      "track": "jp",
      "text": "西部戦線異状なし",
      "translation_ko": "서부전선 이상없다",
      "source": "Tatoeba #958526",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "せいぶせんせんいじょうなし"
    },
    {
      "character_key": "員",
      "track": "jp",
      "text": "会社員です。",
      "translation_ko": "회사원입니다.",
      "source": "Tatoeba #3326577",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "かいしゃいんです。"
    },
    {
      "character_key": "度",
      "track": "jp",
      "text": "３角形のすべての角の和は１８０度に等しい。",
      "translation_ko": "삼각형에 있는 모든 각도의 합은 180도야.",
      "source": "Tatoeba #235339",
      "source_kind": "corpus",
      "target_index": 15,
      "rank": 0,
      "reading": "さんかくけいのすべてのかくのわはひゃくはちじゅうどにひとしい。"
    },
    {
      "character_key": "由",
      "track": "jp",
      "text": "自由の身ね。",
      "translation_ko": "자유로운 사람이야.",
      "source": "Tatoeba #13354000",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "じゆうのみね。"
    },
    {
      "character_key": "館",
      "track": "jp",
      "text": "これは図書館だ。",
      "translation_ko": "이건 도서관이야.",
      "source": "Tatoeba #13228458",
      "source_kind": "corpus",
      "target_index": 5,
      "rank": 0,
      "reading": "これはとしょかんだ。"
    },
    {
      "character_key": "事",
      "track": "jp",
      "text": "火事の原因は不明だ。",
      "translation_ko": "화재의 원인은 알려지지 않았어.",
      "source": "Tatoeba #10952568",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "かじのげんいんはふめいだ。"
    },
    {
      "character_key": "息",
      "track": "jp",
      "text": "息子です。",
      "translation_ko": "내 아들이에요.",
      "source": "Tatoeba #4562142",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "むすこです。"
    },
    {
      "character_key": "族",
      "track": "jp",
      "text": "家族は大切だ。",
      "translation_ko": "가족은 소중하다.",
      "source": "Tatoeba #6135294",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "かぞくはたいせつだ。"
    },
    {
      "character_key": "者",
      "track": "jp",
      "text": "トムは正直者だ。",
      "translation_ko": "톰은 정직하다.",
      "source": "Tatoeba #8596781",
      "source_kind": "corpus",
      "target_index": 5,
      "rank": 0,
      "reading": "とむはしょうじきものだ。"
    },
    {
      "character_key": "住",
      "track": "jp",
      "text": "東京に住んでいる。",
      "translation_ko": "도쿄에 삽니다.",
      "source": "Tatoeba #13535405",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "とうきょうにすんでいる。"
    },
    {
      "character_key": "所",
      "track": "jp",
      "text": "この場所に？",
      "translation_ko": "여기서요?",
      "source": "Tatoeba #221084",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "このばしょに？"
    },
    {
      "character_key": "都",
      "track": "jp",
      "text": "京都生まれです。",
      "translation_ko": "교토에서 태어났어.",
      "source": "Tatoeba #13136009",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "きょうとうまれです。"
    },
    {
      "character_key": "安",
      "track": "jp",
      "text": "安心して。",
      "translation_ko": "안심하세요.",
      "source": "Tatoeba #11040345",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "あんしんして。"
    },
    {
      "character_key": "寒",
      "track": "jp",
      "text": "足が寒い。",
      "translation_ko": "나는 발이 차다.",
      "source": "Tatoeba #10588114",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "あしがさむい。"
    },
    {
      "character_key": "暗",
      "track": "jp",
      "text": "灯台下暗し。",
      "translation_ko": "등잔 밑이 어둡다.",
      "source": "Tatoeba #354110",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "とうだいもとくらし。"
    },
    {
      "character_key": "美",
      "track": "jp",
