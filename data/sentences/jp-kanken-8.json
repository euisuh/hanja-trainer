{
  "sentences": [
    {
      "character_key": "拾",
      "track": "jp",
      "text": "貝殻を拾いながら、波打ち際を歩いた。",
      "translation_ko": "조개껍데기를 주우면서 물가를 걸었다.",
      "source": "Tatoeba #13146683",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "かいがらをひろいながら、なみうちぎわをあるいた。"
    },
    {
      "character_key": "開",
      "track": "jp",
      "text": "店は9時開店です。",
      "translation_ko": "가게는 9시 오픈입니다.",
      "source": "Tatoeba #11957970",
      "source_kind": "corpus",
      "target_index": 4,
      "rank": 0,
      "reading": "みせはくじかいてんです。"
    },
    {
      "character_key": "終",
      "track": "jp",
      "text": "これで終わりです。",
      "translation_ko": "이것으로 끝입니다.",
      "source": "Tatoeba #218759",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "これでおわりです。"
    },
    {
      "character_key": "始",
      "track": "jp",
      "text": "いつ始めるつもりですか？",
      "translation_ko": "언제 시작할 생각이에요?",
      "source": "Tatoeba #10014826",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "いつはじめるつもりですか？"
    },
    {
      "character_key": "飲",
      "track": "jp",
      "text": "飲みたいです。",
      "translation_ko": "마시고 싶어요.",
      "source": "Tatoeba #5069844",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "のみたいです。"
    },
    {
      "character_key": "勉",
      "track": "jp",
      "text": "私は韓国語を勉強します。",
      "translation_ko": "저는 한국어를 공부해요.",
      "source": "Tatoeba #472101",
      "source_kind": "corpus",
      "target_index": 6,
      "rank": 0,
      "reading": "わたしはかんこくごをべんきょうします。"
    },
    {
      "character_key": "商",
      "track": "jp",
      "text": "彼は商才にたけている。",
      "translation_ko": "그는 상재가 뛰어나다.",
      "source": "Tatoeba #104197",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "かれはしょうさいにたけている。"
    },
    {
      "character_key": "勝",
      "track": "jp",
      "text": "楽勝だよ。",
      "translation_ko": "껌이다.",
      "source": "Tatoeba #184131",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "らくしょうだよ。"
    },
    {
      "character_key": "待",
      "track": "jp",
      "text": "児童虐待は犯罪です。",
      "translation_ko": "아동학대는 범죄입니다.",
      "source": "Tatoeba #11434175",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "じどうぎゃくたいははんざいです。"
    },
    {
      "character_key": "取",
      "track": "jp",
      "text": "僕はシャツを取り替えます。",
      "translation_ko": "나는 셔츠를 바꿀 것이다.",
      "source": "Tatoeba #82083",
      "source_kind": "corpus",
      "target_index": 6,
      "rank": 0,
      "reading": "ぼくはしゃつをとりかえます。"
    },
    {
      "character_key": "曲",
      "track": "jp",
      "text": "左に曲がって。",
      "translation_ko": "좌회전해.",
      "source": "Tatoeba #5253128",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "ひだりにまがって。"
    },
    {
      "character_key": "具",
      "track": "jp",
      "text": "ステーキの焼き具合はどうなさいますか。",
      "translation_ko": "스테이크 굽기는 어떻게 해드릴까요?",
      "source": "Tatoeba #1099174",
      "source_kind": "corpus",
      "target_index": 7,
      "rank": 0,
      "reading": "すてーきのやきぐあいはどうなさいますか。"
    },
    {
      "character_key": "宿",
      "track": "jp",
      "text": "百合は宿根草です。",
      "translation_ko": "백합은 여러해살이 식물이야.",
      "source": "Tatoeba #10650876",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "ゆりはしゅっこんそうです。"
    },
    {
      "character_key": "問",
      "track": "jp",
      "text": "質問があります。",
      "translation_ko": "질문 있어요.",
      "source": "Tatoeba #149535",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "しつもんがあります。"
    },
    {
      "character_key": "葉",
      "track": "jp",
      "text": "葉の色がとても美しいです。",
      "translation_ko": "나뭇잎 색이 정말 아름다워요.",
      "source": "Tatoeba #13543049",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "はのいろがとてもうつくしいです。"
    },
    {
      "character_key": "島",
      "track": "jp",
      "text": "海の上に島があります。",
      "translation_ko": "바다에는 섬이 있다.",
      "source": "Tatoeba #3670969",
      "source_kind": "corpus",
      "target_index": 4,
      "rank": 0,
      "reading": "うみのうえにしまがあります。"
    },
    {
      "character_key": "等",
      "track": "jp",
      "text": "誰もが法の下では平等です。",
      "translation_ko": "법 이전에 모두는 평등해.",
      "source": "Tatoeba #1037435",
      "source_kind": "corpus",
      "target_index": 9,
      "rank": 0,
      "reading": "だれもがほうのもとではびょうどうです。"
    },
    {
      "character_key": "部",
      "track": "jp",
      "text": "この部屋は貸間です。",
      "translation_ko": "이 방은 셋방입니다.",
      "source": "Tatoeba #219987",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "このへやはかしまです。"
    },
    {
      "character_key": "員",
      "track": "jp",
      "text": "会社員です。",
      "translation_ko": "회사원입니다.",
      "source": "Tatoeba #3326577",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "かいしゃいんです。"
    },
    {
      "character_key": "度",
      "track": "jp",
      "text": "今度は誰の番ですか。",
      "translation_ko": "이제 누구 차례지?",
      "source": "Tatoeba #172092",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "こんどはだれのばんですか。"
    },
    {
      "character_key": "由",
      "track": "jp",
      "text": "十二支に猫がいない理由はとても簡単です。",
      "translation_ko": "십이간지에 고양이가 없는 이유는 아주 간단합니다.",
      "source": "Tatoeba #13543018",
      "source_kind": "corpus",
      "target_index": 10,
      "rank": 0,
      "reading": "じゅうにしにねこがいないりゆうはとてもかんたんです。"
    },
    {
      "character_key": "館",
      "track": "jp",
      "text": "これは図書館です。",
      "translation_ko": "이곳은 도서관입니다.",
      "source": "Tatoeba #13228453",
      "source_kind": "corpus",
      "target_index": 5,
      "rank": 0,
      "reading": "これはとしょかんです。"
    },
    {
      "character_key": "事",
      "track": "jp",
      "text": "仕事中です。",
      "translation_ko": "나는 일하는 중이다.",
      "source": "Tatoeba #1046221",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "しごとちゅうです。"
    },
    {
      "character_key": "息",
      "track": "jp",
      "text": "息子です。",
      "translation_ko": "내 아들이에요.",
      "source": "Tatoeba #4562142",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "むすこです。"
    },
    {
      "character_key": "族",
      "track": "jp",
      "text": "子供のいる家族はみな特別料金です。",
      "translation_ko": "아이가 있는 모든 가족들은 가격 할인을 받는다.",
      "source": "Tatoeba #168657",
      "source_kind": "corpus",
      "target_index": 6,
      "rank": 0,
      "reading": "こどものいるかぞくはみなとくべつりょうきんです。"
    },
    {
      "character_key": "者",
      "track": "jp",
      "text": "私は医者です。",
      "translation_ko": "나는 의사예요.",
      "source": "Tatoeba #158511",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "わたしはいしゃです。"
    },
    {
      "character_key": "住",
      "track": "jp",
      "text": "日本に住んでますか？",
      "translation_ko": "일본에 사세요?",
      "source": "Tatoeba #13661160",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "にっぽんにすんでますか？"
    },
    {
      "character_key": "所",
      "track": "jp",
      "text": "事務所で働いています。",
      "translation_ko": "사무실에서 일하고 있어요.",
      "source": "Tatoeba #13117167",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "じむしょではたらいています。"
    },
    {
      "character_key": "都",
      "track": "jp",
      "text": "京都生まれです。",
      "translation_ko": "교토에서 태어났어.",
      "source": "Tatoeba #13136009",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "きょうとうまれです。"
    },
    {
      "character_key": "安",
      "track": "jp",
      "text": "これは安いです。",
      "translation_ko": "이건 쉬워요.",
      "source": "Tatoeba #1944403",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "これはやすいです。"
    },
    {
      "character_key": "寒",
      "track": "jp",
      "text": "寒いです。",
      "translation_ko": "추워요.",
      "source": "Tatoeba #945288",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "さむいです。"
    },
    {
      "character_key": "暗",
      "track": "jp",
      "text": "夜は暗くて寒いです。",
      "translation_ko": "밤은 어둡고 추워요.",
      "source": "Tatoeba #13123240",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "よるはくらくてさむいです。"
    },
    {
      "character_key": "美",
      "track": "jp",
      "text": "美味しいです。",
      "translation_ko": "맛있어요!",
      "source": "Tatoeba #12890061",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "おいしいです。"
    },
    {
      "character_key": "和",
      "track": "jp",
      "text": "愛と平和です。",
      "translation_ko": "사랑과 평화.",
      "source": "Tatoeba #191559",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "あいとへいわです。"
    },
    {
      "character_key": "君",
      "track": "jp",
      "text": "君はいい子です。",
      "translation_ko": "아이 착하다.",
      "source": "Tatoeba #177941",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "きみはいいこです。"
    },
    {
      "character_key": "死",
      "track": "jp",
      "text": "食べないと死にますよ。",
      "translation_ko": "먹지 않으면 죽는다고요.",
      "source": "Tatoeba #1485338",
      "source_kind": "corpus",
      "target_index": 5,
      "rank": 0,
      "reading": "たべないとしにますよ。"
    },
    {
      "character_key": "注",
      "track": "jp",
      "text": "本、注文した？",
      "translation_ko": "책 주문했어?",
      "source": "Tatoeba #1944414",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "ほん、ちゅうもんした？"
    },
    {
      "character_key": "意",
      "track": "jp",
      "text": "同じ意見です。",
      "translation_ko": "동의해.",
      "source": "Tatoeba #774830",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "おなじいけんです。"
    },
    {
      "character_key": "波",
      "track": "jp",
      "text": "貝殻を拾いながら、波打ち際を歩いた。",
      "translation_ko": "조개껍데기를 주우면서 물가를 걸었다.",
      "source": "Tatoeba #13146683",
      "source_kind": "corpus",
      "target_index": 9,
      "rank": 0,
      "reading": "かいがらをひろいながら、なみうちぎわをあるいた。"
    },
    {
      "character_key": "全",
      "track": "jp",
      "text": "全くですね。",
      "translation_ko": "당신 말이 맞아요.",
      "source": "Tatoeba #140904",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "まったくですね。"
    },
    {
      "character_key": "配",
      "track": "jp",
      "text": "心配ご無用！",
      "translation_ko": "걱정하지 마세요.",
      "source": "Tatoeba #10029280",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "しんぱいごむよう！"
    },
    {
      "character_key": "流",
      "track": "jp",
      "text": "橋の下を水が流れています。",
      "translation_ko": "물은 다리 밑으로 흐르고 있어.",
      "source": "Tatoeba #2122000",
      "source_kind": "corpus",
      "target_index": 6,
      "rank": 0,
      "reading": "はしのしたをみずがながれています。"
    },
    {
      "character_key": "實",
      "track": "jp",
      "text": "神の実在を信じますか。",
      "translation_ko": "신을 믿어요?",
      "source": "Tatoeba #144925",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "かみのじつざいをしんじますか。"
    },
    {
      "character_key": "綠",
      "track": "jp",
      "text": "緑です。",
      "translation_ko": "초록색이다.",
      "source": "Tatoeba #11776653",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "みどりです。"
    },
    {
      "character_key": "打",
      "track": "jp",
      "text": "貝殻を拾いながら、波打ち際を歩いた。",
      "translation_ko": "조개껍데기를 주우면서 물가를 걸었다.",
      "source": "Tatoeba #13146683",
      "source_kind": "corpus",
      "target_index": 10,
      "rank": 0,
      "reading": "かいがらをひろいながら、なみうちぎわをあるいた。"
    },
    {
      "character_key": "球",
      "track": "jp",
      "text": "地球は惑星です。",
      "translation_ko": "지구는 행성입니다.",
      "source": "Tatoeba #13541616",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "ちきゅうはわくせいです。"
    },
    {
      "character_key": "面",
      "track": "jp",
      "text": "すごく面白そうですね。",
      "translation_ko": "이렇게 매력적일 수가!",
      "source": "Tatoeba #1039972",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "すごくおもしろそうですね。"
    },
    {
      "character_key": "根",
      "track": "jp",
      "text": "百合は宿根草です。",
      "translation_ko": "백합은 여러해살이 식물이야.",
      "source": "Tatoeba #10650876",
      "source_kind": "corpus",
      "target_index": 4,
      "rank": 0,
      "reading": "ゆりはしゅっこんそうです。"
    },
    {
      "character_key": "鼻",
      "track": "jp",
      "text": "鼻がつまっています。",
      "translation_ko": "코가 막혔다.",
      "source": "Tatoeba #85522",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "はながつまっています。"
    },
    {
      "character_key": "題",
      "track": "jp",
      "text": "宿題は終わったんですか。",
      "translation_ko": "숙제 다 끝냈니?",
      "source": "Tatoeba #147874",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "しゅくだいはおわったんですか。"
    }
  ]
}
