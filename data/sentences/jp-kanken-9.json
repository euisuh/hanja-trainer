{
  "sentences": [
    {
      "character_key": "工",
      "track": "jp",
      "text": "工場で働いています。",
      "translation_ko": "나는 공장에서 일한다.",
      "source": "Tatoeba #10098195",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "こうじょうではたらいています。"
    },
    {
      "character_key": "丸",
      "track": "jp",
      "text": "ボールは丸い。",
      "translation_ko": "공은 둥글다.",
      "source": "Tatoeba #196476",
      "source_kind": "corpus",
      "target_index": 4,
      "rank": 0,
      "reading": "ぼーるはまるい。"
    },
    {
      "character_key": "才",
      "track": "jp",
      "text": "彼は商才にたけている。",
      "translation_ko": "그는 상재가 뛰어나다.",
      "source": "Tatoeba #104197",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "かれはしょうさいにたけている。"
    },
    {
      "character_key": "萬",
      "track": "jp",
      "text": "九千九百九十九に一を足すと一万です。",
      "translation_ko": "구천구백구십구 더하기 일은 만이다.",
      "source": "Tatoeba #9589141",
      "source_kind": "corpus",
      "target_index": 14,
      "rank": 0,
      "reading": "きゅうせんきゅうひゃくきゅうじゅうきゅうにいちをたすといちまんです。"
    },
    {
      "character_key": "今",
      "track": "jp",
      "text": "今、何時ですか。",
      "translation_ko": "몇 시예요?",
      "source": "Tatoeba #172923",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "いま、なんじですか。"
    },
    {
      "character_key": "元",
      "track": "jp",
      "text": "元気です。",
      "translation_ko": "잘 지내요.",
      "source": "Tatoeba #3495032",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "げんきです。"
    },
    {
      "character_key": "公",
      "track": "jp",
      "text": "家の前は公園です。",
      "translation_ko": "집 앞은 공원입니다.",
      "source": "Tatoeba #10901738",
      "source_kind": "corpus",
      "target_index": 4,
      "rank": 0,
      "reading": "いえのまえはこうえんです。"
    },
    {
      "character_key": "内",
      "track": "jp",
      "text": "内緒だよ。",
      "translation_ko": "비밀이야.",
      "source": "Tatoeba #10459384",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "ないしょだよ。"
    },
    {
      "character_key": "切",
      "track": "jp",
      "text": "時間切れですか？",
      "translation_ko": "내 시간 끝났어?",
      "source": "Tatoeba #5692153",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "じかんぎれですか？"
    },
    {
      "character_key": "午",
      "track": "jp",
      "text": "私は今日の午後テニスをします。",
      "translation_ko": "나는 오늘 오후 테니스를 칠 거다.",
      "source": "Tatoeba #156958",
      "source_kind": "corpus",
      "target_index": 5,
      "rank": 0,
      "reading": "わたしはきょうのごごてにすをします。"
    },
    {
      "character_key": "友",
      "track": "jp",
      "text": "彼は私の友達です。",
      "translation_ko": "그분은 제 친구입니다.",
      "source": "Tatoeba #105678",
      "source_kind": "corpus",
      "target_index": 4,
      "rank": 0,
      "reading": "かれはわたしのともだちです。"
    },
    {
      "character_key": "太",
      "track": "jp",
      "text": "太郎、ご飯ですよ。",
      "translation_ko": "다로 밥 먹어!",
      "source": "Tatoeba #138069",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "たろう、ごはんですよ。"
    },
    {
      "character_key": "少",
      "track": "jp",
      "text": "この少女は誰ですか。",
      "translation_ko": "이 소녀는 누구입니까?",
      "source": "Tatoeba #221131",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "このしょうじょはだれですか。"
    },
    {
      "character_key": "引",
      "track": "jp",
      "text": "来月引っ越しするんです。",
      "translation_ko": "우리는 다음 달에 이동한다.",
      "source": "Tatoeba #78677",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "らいげつひっこしするんです。"
    },
    {
      "character_key": "心",
      "track": "jp",
      "text": "同じ心境です。",
      "translation_ko": "동감이에요.",
      "source": "Tatoeba #11592443",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "おなじしんきょうです。"
    },
    {
      "character_key": "戸",
      "track": "jp",
      "text": "これは枯れ井戸です。",
      "translation_ko": "이건 마른 우물이에요.",
      "source": "Tatoeba #13535321",
      "source_kind": "corpus",
      "target_index": 6,
      "rank": 0,
      "reading": "これはかれいどです。"
    },
    {
      "character_key": "方",
      "track": "jp",
      "text": "カナダの方ですか？",
      "translation_ko": "캐나다인이신가요?",
      "source": "Tatoeba #8826489",
      "source_kind": "corpus",
      "target_index": 4,
      "rank": 0,
      "reading": "かなだのかたですか？"
    },
    {
      "character_key": "牛",
      "track": "jp",
      "text": "それは種牛です。",
      "translation_ko": "그것은 황소입니다.",
      "source": "Tatoeba #9930564",
      "source_kind": "corpus",
      "target_index": 4,
      "rank": 0,
      "reading": "それはたねうしです。"
    },
    {
      "character_key": "父",
      "track": "jp",
      "text": "私は父親似です。",
      "translation_ko": "나는 우리 아빠같아.",
      "source": "Tatoeba #9853720",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "わたしはちちおやにです。"
    },
    {
      "character_key": "毛",
      "track": "jp",
      "text": "冬には羊毛の服を着ます。",
      "translation_ko": "겨울에는 양모 옷을 입어요.",
      "source": "Tatoeba #13540954",
      "source_kind": "corpus",
      "target_index": 4,
      "rank": 0,
      "reading": "ふゆにはようもうのふくをきます。"
    },
    {
      "character_key": "止",
      "track": "jp",
      "text": "雨が止んだら行きます。",
      "translation_ko": "비가 그치면 갈게요.",
      "source": "Tatoeba #12945414",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "あめがやんだらいきます。"
    },
    {
      "character_key": "兄",
      "track": "jp",
      "text": "兄弟がいますか。",
      "translation_ko": "형제가 있습니까?",
      "source": "Tatoeba #13131850",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "きょうだいがいますか。"
    },
    {
      "character_key": "冬",
      "track": "jp",
      "text": "私は冬が好きです。",
      "translation_ko": "난 겨울이 좋아.",
      "source": "Tatoeba #154888",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "わたしはふゆがすきです。"
    },
    {
      "character_key": "北",
      "track": "jp",
      "text": "台北から来ました。",
      "translation_ko": "타이베이에서 왔어요.",
      "source": "Tatoeba #13189835",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "たいぺいからきました。"
    },
    {
      "character_key": "半",
      "track": "jp",
      "text": "半袖で寒くないんですか？",
      "translation_ko": "반팔인데 춥지 않나요?",
      "source": "Tatoeba #3440367",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "はんそででさむくないんですか？"
    },
    {
      "character_key": "古",
      "track": "jp",
      "text": "これは大変古い本です。",
      "translation_ko": "이것은 엄청 오래된 책이다.",
      "source": "Tatoeba #218216",
      "source_kind": "corpus",
      "target_index": 5,
      "rank": 0,
      "reading": "これはたいへんふるいほんです。"
    },
    {
      "character_key": "臺",
      "track": "jp",
      "text": "台湾は国です。",
      "translation_ko": "대만은 국가예요.",
      "source": "Tatoeba #13187353",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "たいわんはくにです。"
    },
    {
      "character_key": "外",
      "track": "jp",
      "text": "外出は駄目ですよ。",
      "translation_ko": "나가면 안 돼요.",
      "source": "Tatoeba #11352031",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "がいしゅつはだめですよ。"
    },
    {
      "character_key": "市",
      "track": "jp",
      "text": "市場に入ります。",
      "translation_ko": "시장에 들어갑니다.",
      "source": "Tatoeba #6828223",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "いちばにはいります。"
    },
    {
      "character_key": "廣",
      "track": "jp",
      "text": "なぜ広東語を学んだのですか？",
      "translation_ko": "왜 광동어를 배웠습니까?",
      "source": "Tatoeba #11071812",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "なぜかんとんごをまなんだのですか？"
    },
    {
      "character_key": "母",
      "track": "jp",
      "text": "母は変わり者です。",
      "translation_ko": "우리 어머니는 특이한 사람이다.",
      "source": "Tatoeba #4975876",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "はははかわりものです。"
    },
    {
      "character_key": "用",
      "track": "jp",
      "text": "何のご用ですか。",
      "translation_ko": "뭘 원해요?",
      "source": "Tatoeba #187725",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "なんのごようですか。"
    },
    {
      "character_key": "矢",
      "track": "jp",
      "text": "トムは弓矢で魚を捕るのが好きだ。",
      "translation_ko": "톰은 화살로 물고기를 잡는 것을 좋아합니다.",
      "source": "Tatoeba #8637343",
      "source_kind": "corpus",
      "target_index": 4,
      "rank": 0,
      "reading": "とむはゆみやでさかなをとるのがすきだ。"
    },
    {
      "character_key": "交",
      "track": "jp",
      "text": "交際を続けましょう。",
      "translation_ko": "연락하고 지내요.",
      "source": "Tatoeba #174187",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "こうさいをつづけましょう。"
    },
    {
      "character_key": "會",
      "track": "jp",
      "text": "会社員です。",
      "translation_ko": "회사원입니다.",
      "source": "Tatoeba #3326577",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "かいしゃいんです。"
    },
    {
      "character_key": "光",
      "track": "jp",
      "text": "お会いできて光栄です。",
      "translation_ko": "만나서 반갑습니다.",
      "source": "Tatoeba #227375",
      "source_kind": "corpus",
      "target_index": 6,
      "rank": 0,
      "reading": "おあいできてこうえいです。"
    },
    {
      "character_key": "同",
      "track": "jp",
      "text": "同感です。",
      "translation_ko": "동의해.",
      "source": "Tatoeba #123688",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "どうかんです。"
    },
    {
      "character_key": "回",
      "track": "jp",
      "text": "塩を回していただけますか。",
      "translation_ko": "소금 좀 건네줄래?",
      "source": "Tatoeba #188592",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "しおをまわしていただけますか。"
    },
    {
      "character_key": "多",
      "track": "jp",
      "text": "ユリは多年草です。",
      "translation_ko": "백합은 여러해살이 식물이야.",
      "source": "Tatoeba #10650875",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "ゆりはたねんそうです。"
    },
    {
      "character_key": "當",
      "track": "jp",
      "text": "本当ですか。",
      "translation_ko": "정말이에요?",
      "source": "Tatoeba #1585501",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "ほんとうですか。"
    },
    {
      "character_key": "每",
      "track": "jp",
      "text": "毎朝六時に起きます。",
      "translation_ko": "매일 아침 6시에 일어나요.",
      "source": "Tatoeba #10953992",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "まいあさろくじにおきます。"
    },
    {
      "character_key": "池",
      "track": "jp",
      "text": "電池が切れた。",
      "translation_ko": "배터리가 방전됐어.",
      "source": "Tatoeba #1606820",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "でんちがきれた。"
    },
    {
      "character_key": "米",
      "track": "jp",
      "text": "私は米国人です。",
      "translation_ko": "저는 미국사람 이에요",
      "source": "Tatoeba #152917",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "わたしはべいこくじんです。"
    },
    {
      "character_key": "考",
      "track": "jp",
      "text": "いい考えですね。",
      "translation_ko": "그것은 좋은 생각이야!",
      "source": "Tatoeba #229362",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "いいかんがえですね。"
    },
    {
      "character_key": "肉",
      "track": "jp",
      "text": "お肉をお願いします。",
      "translation_ko": "고기 주세요.",
      "source": "Tatoeba #122985",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "おにくをおねがいします。"
    },
    {
      "character_key": "自",
      "track": "jp",
      "text": "これは自殺ですよ。",
      "translation_ko": "자살입니다.",
      "source": "Tatoeba #3506565",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "これはじさつですよ。"
    },
    {
      "character_key": "色",
      "track": "jp",
      "text": "木は緑色です。",
      "translation_ko": "나무는 초록색이에요.",
      "source": "Tatoeba #13541053",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "きはみどりいろです。"
    },
    {
      "character_key": "行",
      "track": "jp",
      "text": "行って来ます。",
      "translation_ko": "다녀오겠습니다.",
      "source": "Tatoeba #13117611",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "いってきます。"
    },
    {
      "character_key": "西",
      "track": "jp",
      "text": "西部戦線異状なし",
      "translation_ko": "서부전선 이상없다",
      "source": "Tatoeba #958526",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "せいぶせんせんいじょうなし"
    },
    {
      "character_key": "何",
      "track": "jp",
      "text": "何ですか。",
      "translation_ko": "뭘 원해요?",
      "source": "Tatoeba #187850",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "なんですか。"
    },
    {
      "character_key": "體",
      "track": "jp",
      "text": "それでは、体温を測りますね。",
      "translation_ko": "그럼 체온을 측정하겠습니다.",
      "source": "Tatoeba #9846704",
      "source_kind": "corpus",
      "target_index": 5,
      "rank": 0,
      "reading": "それでは、たいおんをはかりますね。"
    },
    {
      "character_key": "作",
      "track": "jp",
      "text": "好きな作家は誰ですか？",
      "translation_ko": "당신이 가장 좋아하는 작가는 누구입니까?",
      "source": "Tatoeba #233311",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "すきなさっかはだれですか？"
    },
    {
      "character_key": "圖",
      "track": "jp",
      "text": "これは図書館です。",
      "translation_ko": "이곳은 도서관입니다.",
      "source": "Tatoeba #13228453",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "これはとしょかんです。"
    },
    {
      "character_key": "聲",
      "track": "jp",
      "text": "彼女の声はとても美しく聞こえます。",
      "translation_ko": "그녀는 목소리가 아주 좋다.",
      "source": "Tatoeba #94206",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "かのじょのこえはとてもうつくしくきこえます。"
    },
    {
      "character_key": "賣",
      "track": "jp",
      "text": "車を売るのが私の仕事です。",
      "translation_ko": "제 직업은 카셀러입니다.",
      "source": "Tatoeba #148928",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "くるまをうるのがわたしのしごとです。"
    },
    {
      "character_key": "弟",
      "track": "jp",
      "text": "兄弟がいますか。",
      "translation_ko": "형제가 있습니까?",
      "source": "Tatoeba #13131850",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "きょうだいがいますか。"
    },
    {
      "character_key": "形",
      "track": "jp",
      "text": "木を形作るのは簡単ではない。",
      "translation_ko": "나무를 다듬는 것은 쉽지 않다.",
      "source": "Tatoeba #13886599",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "きをかたちづくるのはかんたんではない。"
    },
    {
      "character_key": "來",
      "track": "jp",
      "text": "行って来ます。",
      "translation_ko": "다녀오겠습니다.",
      "source": "Tatoeba #13117611",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "いってきます。"
    },
    {
      "character_key": "社",
      "track": "jp",
      "text": "会社員です。",
      "translation_ko": "회사원입니다.",
      "source": "Tatoeba #3326577",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "かいしゃいんです。"
    },
    {
      "character_key": "角",
      "track": "jp",
      "text": "３角形のすべての角の和は１８０度に等しい。",
      "translation_ko": "삼각형에 있는 모든 각도의 합은 180도야.",
      "source": "Tatoeba #235339",
