{
  "sentences": [
    {
      "character_key": "工",
      "track": "jp",
      "text": "工場で働いています。",
      "translation_ko": "나는 공장에서 일한다.",
      "source": "Tatoeba #10098195",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "こうじょうではたらいています。"
    },
    {
      "character_key": "丸",
      "track": "jp",
      "text": "ボールは丸い。",
      "translation_ko": "공은 둥글다.",
      "source": "Tatoeba #196476",
      "source_kind": "corpus",
      "target_index": 4,
      "rank": 0,
      "reading": "ぼーるはまるい。"
    },
    {
      "character_key": "才",
      "track": "jp",
      "text": "彼は商才にたけている。",
      "translation_ko": "그는 상재가 뛰어나다.",
      "source": "Tatoeba #104197",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "かれはしょうさいにたけている。"
    },
    {
      "character_key": "萬",
      "track": "jp",
      "text": "一万円貸してくれない？",
      "translation_ko": "만 엔만 빌려주시겠습니까?",
      "source": "Tatoeba #9049823",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "いちまんえんかしてくれない？"
    },
    {
      "character_key": "今",
      "track": "jp",
      "text": "今の音何？",
      "translation_ko": "지금 이 소리는 뭐지?",
      "source": "Tatoeba #3550819",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "いまのおとなに？"
    },
    {
      "character_key": "元",
      "track": "jp",
      "text": "元気でね！",
      "translation_ko": "잘 있어!",
      "source": "Tatoeba #11256131",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "げんきでね！"
    },
    {
      "character_key": "公",
      "track": "jp",
      "text": "私は公園に行く。",
      "translation_ko": "난 공원에 가요.",
      "source": "Tatoeba #157179",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "わたしはこうえんにいく。"
    },
    {
      "character_key": "内",
      "track": "jp",
      "text": "内緒だよ。",
      "translation_ko": "비밀이야.",
      "source": "Tatoeba #10459384",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "ないしょだよ。"
    },
    {
      "character_key": "分",
      "track": "jp",
      "text": "分かった！",
      "translation_ko": "알겠어!",
      "source": "Tatoeba #1293330",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "わかった！"
    },
    {
      "character_key": "切",
      "track": "jp",
      "text": "家族は大切だ。",
      "translation_ko": "가족은 소중하다.",
      "source": "Tatoeba #6135294",
      "source_kind": "corpus",
      "target_index": 4,
      "rank": 0,
      "reading": "かぞくはたいせつだ。"
    },
    {
      "character_key": "午",
      "track": "jp",
      "text": "会は正午に終わった。",
      "translation_ko": "그 회의는 정오에 끝났다.",
      "source": "Tatoeba #185433",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "かいはしょうごにおわった。"
    },
    {
      "character_key": "友",
      "track": "jp",
      "text": "これ、私の友だち。",
      "translation_ko": "이거 내 친구야.",
      "source": "Tatoeba #13228480",
      "source_kind": "corpus",
      "target_index": 5,
      "rank": 0,
      "reading": "これ、わたしのともだち。"
    },
    {
      "character_key": "太",
      "track": "jp",
      "text": "太りたくない。",
      "translation_ko": "살 찌고 싶지 않아.",
      "source": "Tatoeba #10792742",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "ふとりたくない。"
    },
    {
      "character_key": "少",
      "track": "jp",
      "text": "少し待ってて。",
      "translation_ko": "잠깐만요.",
      "source": "Tatoeba #10608937",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "すこしまってて。"
    },
    {
      "character_key": "引",
      "track": "jp",
      "text": "風邪引いちゃった。",
      "translation_ko": "감기 걸렸어.",
      "source": "Tatoeba #10557638",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "かぜひいちゃった。"
    },
    {
      "character_key": "心",
      "track": "jp",
      "text": "安心して。",
      "translation_ko": "안심하세요.",
      "source": "Tatoeba #11040345",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "あんしんして。"
    },
    {
      "character_key": "戸",
      "track": "jp",
      "text": "戸を閉めろ。",
      "translation_ko": "문을 닫아!",
      "source": "Tatoeba #174533",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "とをしめろ。"
    },
    {
      "character_key": "方",
      "track": "jp",
      "text": "早い方がいい。",
      "translation_ko": "더 빨리할수록 좋다.",
      "source": "Tatoeba #11571060",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "はやいほうがいい。"
    },
    {
      "character_key": "牛",
      "track": "jp",
      "text": "それは種牛です。",
      "translation_ko": "그것은 황소입니다.",
      "source": "Tatoeba #9930564",
      "source_kind": "corpus",
      "target_index": 4,
      "rank": 0,
      "reading": "それはたねうしです。"
    },
    {
      "character_key": "父",
      "track": "jp",
      "text": "父は家にいる。",
      "translation_ko": "우리 아버지는 집에 계신다.",
      "source": "Tatoeba #84631",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "ちちはいえにいる。"
    },
    {
      "character_key": "毛",
      "track": "jp",
      "text": "彼女の髪の毛は長い。",
      "translation_ko": "그녀의 머리카락은 길어.",
      "source": "Tatoeba #94078",
      "source_kind": "corpus",
      "target_index": 5,
      "rank": 0,
      "reading": "かのじょのかみのけはながい。"
    },
    {
      "character_key": "止",
      "track": "jp",
      "text": "駐車禁止！",
      "translation_ko": "주차 금지!",
      "source": "Tatoeba #13177727",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "ちゅうしゃきんし！"
    },
    {
      "character_key": "兄",
      "track": "jp",
      "text": "兄弟がいますか。",
      "translation_ko": "형제가 있습니까?",
      "source": "Tatoeba #13131850",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "きょうだいがいますか。"
    },
    {
      "character_key": "冬",
      "track": "jp",
      "text": "冬休み何日から？",
      "translation_ko": "겨울방학은 며칠부터야?",
      "source": "Tatoeba #4661510",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "ふゆやすみなんにちから？"
    },
    {
      "character_key": "北",
      "track": "jp",
      "text": "台北から来ました。",
      "translation_ko": "타이베이에서 왔어요.",
      "source": "Tatoeba #13189835",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "たいぺいからきました。"
    },
    {
      "character_key": "半",
      "track": "jp",
      "text": "８時半に学校は始まる。",
      "translation_ko": "8시 반에 학교가 시작된다.",
      "source": "Tatoeba #9229993",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "はちじはんにがっこうははじまる。"
    },
    {
      "character_key": "古",
      "track": "jp",
      "text": "古すぎるわ。",
      "translation_ko": "그건 너무 낡았어.",
      "source": "Tatoeba #3506567",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "ふるすぎるわ。"
    },
    {
      "character_key": "臺",
      "track": "jp",
      "text": "灯台下暗し。",
      "translation_ko": "등잔 밑이 어둡다.",
      "source": "Tatoeba #354110",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "とうだいもとくらし。"
    },
    {
      "character_key": "外",
      "track": "jp",
      "text": "外に出ろ。",
      "translation_ko": "나가.",
      "source": "Tatoeba #184886",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "そとにでろ。"
    },
    {
      "character_key": "市",
      "track": "jp",
      "text": "市場に入ります。",
      "translation_ko": "시장에 들어갑니다.",
      "source": "Tatoeba #6828223",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "いちばにはいります。"
    },
    {
      "character_key": "廣",
      "track": "jp",
      "text": "なぜ広東語を学んだのですか？",
      "translation_ko": "왜 광동어를 배웠습니까?",
      "source": "Tatoeba #11071812",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "なぜかんとんごをまなんだのですか？"
    },
    {
      "character_key": "母",
      "track": "jp",
      "text": "母なる地球。",
      "translation_ko": "어머니 지구.",
      "source": "Tatoeba #13541610",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "ははなるちきゅう。"
    },
    {
      "character_key": "用",
      "track": "jp",
      "text": "心配ご無用！",
      "translation_ko": "걱정하지 마세요.",
      "source": "Tatoeba #10029280",
      "source_kind": "corpus",
      "target_index": 4,
      "rank": 0,
      "reading": "しんぱいごむよう！"
    },
    {
      "character_key": "矢",
      "track": "jp",
      "text": "トムは弓矢で魚を捕るのが好きだ。",
      "translation_ko": "톰은 화살로 물고기를 잡는 것을 좋아합니다.",
      "source": "Tatoeba #8637343",
      "source_kind": "corpus",
      "target_index": 4,
      "rank": 0,
      "reading": "とむはゆみやでさかなをとるのがすきだ。"
    },
    {
      "character_key": "交",
      "track": "jp",
      "text": "交際を続けましょう。",
      "translation_ko": "연락하고 지내요.",
      "source": "Tatoeba #174187",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "こうさいをつづけましょう。"
    },
    {
      "character_key": "會",
      "track": "jp",
      "text": "会いたい！",
      "translation_ko": "보고 싶어!",
      "source": "Tatoeba #13182095",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "あいたい！"
    },
    {
      "character_key": "光",
      "track": "jp",
      "text": "私は光が見える。",
      "translation_ko": "그 빛을 볼 수 있다.",
      "source": "Tatoeba #1608694",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "わたしはひかりがみえる。"
    },
    {
      "character_key": "同",
      "track": "jp",
      "text": "同意する。",
      "translation_ko": "동의해.",
      "source": "Tatoeba #9101658",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "どういする。"
    },
    {
      "character_key": "回",
      "track": "jp",
      "text": "もう一回。",
      "translation_ko": "한 번 더.",
      "source": "Tatoeba #194347",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "もういっかい。"
    },
    {
      "character_key": "多",
      "track": "jp",
      "text": "多分そうだよ。",
      "translation_ko": "아마도 그럴 것이야.",
      "source": "Tatoeba #8823041",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "たぶんそうだよ。"
    },
    {
      "character_key": "當",
      "track": "jp",
      "text": "それ本当？",
      "translation_ko": "정말이야?",
      "source": "Tatoeba #3488459",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "それほんとう？"
    },
    {
      "character_key": "每",
      "track": "jp",
      "text": "勉強は毎日してる？",
      "translation_ko": "공부는 매일 하고 있어?",
      "source": "Tatoeba #10125595",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "べんきょうはまいにちしてる？"
    },
    {
      "character_key": "池",
      "track": "jp",
      "text": "電池が切れた。",
      "translation_ko": "배터리가 방전됐어.",
      "source": "Tatoeba #1606820",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "でんちがきれた。"
    },
    {
      "character_key": "米",
      "track": "jp",
      "text": "私は米国人です。",
      "translation_ko": "저는 미국사람 이에요",
      "source": "Tatoeba #152917",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "わたしはべいこくじんです。"
    },
    {
      "character_key": "考",
      "track": "jp",
      "text": "良い考えだね！",
      "translation_ko": "그것은 좋은 생각이야!",
      "source": "Tatoeba #4974",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "よいかんがえだね！"
    },
    {
      "character_key": "肉",
      "track": "jp",
      "text": "全身筋肉痛だ。",
      "translation_ko": "온 몸이 쑤신다.",
      "source": "Tatoeba #140798",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "ぜんしんきんにくつうだ。"
    },
    {
      "character_key": "自",
      "track": "jp",
      "text": "自由の身ね。",
      "translation_ko": "자유로운 사람이야.",
      "source": "Tatoeba #13354000",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "じゆうのみね。"
    },
    {
      "character_key": "色",
      "track": "jp",
      "text": "木は緑色です。",
      "translation_ko": "나무는 초록색이에요.",
      "source": "Tatoeba #13541053",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "きはみどりいろです。"
    },
    {
      "character_key": "行",
      "track": "jp",
      "text": "どこ行くの？",
      "translation_ko": "어디에 가요?",
      "source": "Tatoeba #3595435",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "どこいくの？"
    },
    {
      "character_key": "西",
      "track": "jp",
      "text": "西部戦線異状なし",
      "translation_ko": "서부전선 이상없다",
      "source": "Tatoeba #958526",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "せいぶせんせんいじょうなし"
    },
    {
      "character_key": "何",
      "track": "jp",
      "text": "何しょん？",
      "translation_ko": "여보, 뭐 하고 있어요?",
      "source": "Tatoeba #13204558",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "なにしょん？"
    },
    {
      "character_key": "體",
      "track": "jp",
      "text": "体中が痛い。",
      "translation_ko": "온 몸이 쑤신다.",
      "source": "Tatoeba #226181",
      "source_kind": "corpus",
      "target_index": 0,
      "rank": 0,
      "reading": "からだじゅうがいたい。"
    },
    {
      "character_key": "作",
      "track": "jp",
      "text": "何作ったの？",
      "translation_ko": "뭘 하셨어요?",
      "source": "Tatoeba #3552882",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "なにつくったの？"
    },
    {
      "character_key": "圖",
      "track": "jp",
      "text": "これは図書館だ。",
      "translation_ko": "이건 도서관이야.",
      "source": "Tatoeba #13228458",
      "source_kind": "corpus",
      "target_index": 3,
      "rank": 0,
      "reading": "これはとしょかんだ。"
    },
    {
      "character_key": "聲",
      "track": "jp",
      "text": "君の声が聞こえる。",
      "translation_ko": "너의 목소리가 들려",
      "source": "Tatoeba #8658133",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "きみのこえがきこえる。"
    },
    {
      "character_key": "賣",
      "track": "jp",
      "text": "魂を売ったのか？",
      "translation_ko": "걔 영혼 팔았냐?",
      "source": "Tatoeba #9788059",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "たましいをうったのか？"
    },
    {
      "character_key": "弟",
      "track": "jp",
      "text": "兄弟がいますか。",
      "translation_ko": "형제가 있습니까?",
      "source": "Tatoeba #13131850",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "きょうだいがいますか。"
    },
    {
      "character_key": "形",
      "track": "jp",
      "text": "木を形作るのは簡単ではない。",
      "translation_ko": "나무를 다듬는 것은 쉽지 않다.",
      "source": "Tatoeba #13886599",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "きをかたちづくるのはかんたんではない。"
    },
    {
      "character_key": "來",
      "track": "jp",
      "text": "彼は来た！",
      "translation_ko": "그는 왔어!",
      "source": "Tatoeba #5102848",
      "source_kind": "corpus",
      "target_index": 2,
      "rank": 0,
      "reading": "かれはきた！"
    },
    {
      "character_key": "社",
      "track": "jp",
      "text": "会社員です。",
      "translation_ko": "회사원입니다.",
      "source": "Tatoeba #3326577",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "かいしゃいんです。"
    },
    {
      "character_key": "角",
      "track": "jp",
      "text": "３角形のすべての角の和は１８０度に等しい。",
      "translation_ko": "삼각형에 있는 모든 각도의 합은 180도야.",
      "source": "Tatoeba #235339",
      "source_kind": "corpus",
      "target_index": 1,
      "rank": 0,
      "reading": "さんかくけいのすべてのかくのわはひゃくはちじゅうどにひとしい。"
    },
    {
      "character_key": "言",
      "track": "jp",
      "text": "何か言った？",
      "translation_ko": "뭐라고 했어요?",
      "source": "Tatoeba #10176373",
