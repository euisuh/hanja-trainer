{
  "units": [
    {
      "ord": 3,
      "titleKo": "편의점 계산",
      "goalKo": "편의점 점원의 질문에 알맞게 대답하며 계산을 마친다."
    }
  ],
  "chunks": [
    {
      "unitOrd": 3,
      "ord": 1,
      "text": "いらっしゃいませ。",
      "kana": "いらっしゃいませ。",
      "cueKo": "점원이 손님을 맞이하는 인사 듣기",
      "register": "keigo",
      "role": "hear",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #338114",
      "audioKey": "c/cc6d85fe3eef930d",
      "key": "tatoeba-338114-hear"
    },
    {
      "unitOrd": 3,
      "ord": 2,
      "text": "ポイントカードはお持ちですか？",
      "kana": "ポイントカードはおもちですか？",
      "cueKo": "포인트 카드가 있냐는 점원의 질문 듣기",
      "register": "keigo",
      "role": "hear",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #3515218",
      "audioKey": "c/2d7d9d245d3470ad",
      "key": "tatoeba-3515218-hear"
    },
    {
      "unitOrd": 3,
      "ord": 3,
      "text": "以上ですか？",
      "kana": "いじょうですか？",
      "cueKo": "더 살 것이 없는지 묻는 말 듣기",
      "register": "polite",
      "role": "hear",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #191216",
      "audioKey": "c/a491860046c1194f",
      "key": "tatoeba-191216-hear"
    },
    {
      "unitOrd": 3,
      "ord": 4,
      "text": "全部で三千円です。",
      "kana": "ぜんぶでさんぜんえんです。",
      "cueKo": "점원이 전체 금액을 말하는 것 듣기",
      "register": "polite",
      "role": "hear",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #205018",
      "audioKey": "c/4e77f507519180b3",
      "key": "tatoeba-205018-hear"
    },
    {
      "unitOrd": 3,
      "ord": 5,
      "text": "これください。",
      "kana": "これください。",
      "cueKo": "물건을 가리키며 이거 달라고 하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #8583430",
      "audioKey": "c/96893f0154ea9b99",
      "key": "tatoeba-8583430-say"
    },
    {
      "unitOrd": 3,
      "ord": 6,
      "text": "以上です。",
      "kana": "いじょうです。",
      "cueKo": "더 살 것이 없다고 말하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #2154940",
      "audioKey": "c/8f68cdcce7307e86",
      "key": "tatoeba-2154940-say"
    },
    {
      "unitOrd": 3,
      "ord": 7,
      "text": "お願いします。",
      "kana": "おねがいします。",
      "cueKo": "점원의 제안에 부탁한다고 답하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #926739",
      "audioKey": "c/166d84de42c2d0ed",
      "key": "tatoeba-926739-say"
    },
    {
      "unitOrd": 3,
      "ord": 8,
      "text": "大丈夫です。",
      "kana": "だいじょうぶです。",
      "cueKo": "괜찮다고 정중하게 거절하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #2304911",
      "audioKey": "c/e93d846ebd8d70c8",
      "key": "tatoeba-2304911-say"
    },
    {
      "unitOrd": 3,
      "ord": 9,
      "text": "いえ、結構です。",
      "kana": "いえ、けっこうです。",
      "cueKo": "필요 없다고 정중하게 사양하기 (편의점에서는 大丈夫です가 더 자연스러움)",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #229316",
      "audioKey": "c/a309fe2fbfd2b145",
      "key": "tatoeba-229316-say"
    },
    {
      "unitOrd": 3,
      "ord": 10,
      "text": "カードでお願いします。",
      "kana": "カードでおねがいします。",
      "cueKo": "카드로 계산해 달라고 하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #226474",
      "audioKey": "c/68c189e83c3cb762",
      "key": "tatoeba-226474-say"
    },
    {
      "unitOrd": 3,
      "ord": 11,
      "text": "ビニール袋に入れてください。",
      "kana": "ビニールぶくろにいれてください。",
      "cueKo": "비닐봉지에 담아 달라고 하기 (봉지가 유료가 된 뒤로는 袋お願いします가 더 흔함)",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #197456",
      "audioKey": "c/6925e735a20c4c85",
      "key": "tatoeba-197456-say"
    },
    {
      "unitOrd": 3,
      "ord": 12,
      "text": "スプーンをいただけますか。",
      "kana": "スプーンをいただけますか。",
      "cueKo": "스푼을 받을 수 있는지 정중히 묻기",
      "register": "keigo",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #214525",
      "audioKey": "c/3bd8a5e4bea15e17",
      "key": "tatoeba-214525-say"
    },
    {
      "unitOrd": 3,
      "ord": 13,
      "text": "レシートはいりません。",
      "kana": "レシートはいりません。",
      "cueKo": "영수증은 필요 없다고 말하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #12024147",
      "audioKey": "c/2086a2e4e764c3c2",
      "key": "tatoeba-12024147-say"
    },
    {
      "unitOrd": 3,
      "ord": 14,
      "text": "レシートをください。",
      "kana": "レシートをください。",
      "cueKo": "영수증을 달라고 하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #10647275",
      "audioKey": "c/ecefb8e384948b36",
      "key": "tatoeba-10647275-say"
    },
    {
      "unitOrd": 3,
      "ord": 15,
      "text": "袋はご利用ですか？",
      "kana": "ふくろはごりようですか？",
      "cueKo": "봉투가 필요하냐고 묻는 점원의 말 듣기",
      "register": "keigo",
      "role": "hear",
      "sourceKind": "authored",
      "ownerApproved": "2026-11-06",
      "authoredScope": "npc",
      "reviewNote": "Staff line, standard phrasing used at a convenience-store till. Authored for this app; no standalone Tatoeba sentence (GAPS.md).",
      "noteKo": "ご利用ですか는 '쓰시겠어요?'. 봉투가 유료라서 나오는 질문",
      "audioKey": "c/817a19272a294152",
      "key": "authored-501b6690c7-hear"
    },
    {
      "unitOrd": 3,
      "ord": 16,
      "text": "お箸はお付けしますか？",
      "kana": "おはしはおつけしますか？",
      "cueKo": "젓가락을 넣어 줄지 묻는 점원의 말 듣기",
      "register": "keigo",
      "role": "hear",
      "sourceKind": "authored",
      "ownerApproved": "2026-11-06",
      "authoredScope": "npc",
      "reviewNote": "Staff line, standard phrasing used at a convenience-store till. Authored for this app; no standalone Tatoeba sentence (GAPS.md).",
      "noteKo": "お付けします는 '붙여 드릴까요'. 대답은 お願いします나 大丈夫です",
      "audioKey": "c/cee7bd40c765a16a",
      "key": "authored-7f3ac2152d-hear"
    },
    {
      "unitOrd": 3,
      "ord": 17,
      "text": "お弁当は温めますか？",
      "kana": "おべんとうはあたためますか？",
      "cueKo": "도시락을 데워 줄지 묻는 점원의 말 듣기",
      "register": "polite",
      "role": "hear",
      "sourceKind": "authored",
      "ownerApproved": "2026-11-06",
      "authoredScope": "npc",
      "reviewNote": "Staff line, standard phrasing used at a convenience-store till. Authored for this app; no standalone Tatoeba sentence (GAPS.md).",
      "noteKo": "温めます는 '데우다'. 대답은 お願いします / 大丈夫です",
      "audioKey": "c/492f41822209a433",
      "key": "authored-69d9e67c84-hear"
    },
    {
      "unitOrd": 3,
      "ord": 18,
      "text": "合計で五百八十円になります。",
      "kana": "ごうけいでごひゃくはちじゅうえんになります。",
      "cueKo": "점원이 합계 금액을 말하는 것 듣기",
      "register": "polite",
      "role": "hear",
      "sourceKind": "authored",
      "ownerApproved": "2026-11-06",
      "authoredScope": "npc",
      "reviewNote": "Staff line, standard phrasing used at a till when stating the total. Authored for this app; no standalone Tatoeba sentence (GAPS.md).",
      "noteKo": "〜になります는 '변하다'가 아니라 '〜입니다'라는 점원 말투",
      "audioKey": "c/cde6b426e97c652d",
      "key": "authored-46b1bbca70-hear"
    },
    {
      "unitOrd": 3,
      "ord": 19,
      "text": "千円お預かりします。",
      "kana": "せんえんおあずかりします。",
      "cueKo": "점원이 받은 돈을 확인하는 말 듣기",
      "register": "keigo",
      "role": "hear",
      "sourceKind": "authored",
      "ownerApproved": "2026-11-06",
      "authoredScope": "npc",
      "reviewNote": "Staff line, standard phrasing used at a till when taking cash. Authored for this app; no standalone Tatoeba sentence (GAPS.md).",
      "noteKo": "お預かりします는 '받겠습니다'. 거스름돈이 나온다는 신호",
      "audioKey": "c/04698af922558903",
      "key": "authored-61ba579a94-hear"
    },
    {
      "unitOrd": 3,
      "ord": 20,
      "text": "四百二十円のお返しです。",
      "kana": "よんひゃくにじゅうえんのおかえしです。",
      "cueKo": "점원이 거스름돈을 건네며 하는 말 듣기",
      "register": "polite",
      "role": "hear",
      "sourceKind": "authored",
      "ownerApproved": "2026-11-06",
      "authoredScope": "npc",
      "reviewNote": "Staff line, standard phrasing used at a till when giving change. Authored for this app; no standalone Tatoeba sentence (GAPS.md).",
      "noteKo": "お返し는 '거스름돈'. 400은 よんひゃく (よっ、しひゃく 아님)",
      "audioKey": "c/bb937ab511751e29",
      "key": "authored-e88025c88f-hear"
    },
    {
      "unitOrd": 3,
      "ord": 21,
      "text": "ありがとうございました。",
      "kana": "ありがとうございました。",
      "cueKo": "점원이 계산 뒤에 하는 인사 듣기",
      "register": "keigo",
      "role": "hear",
      "sourceKind": "authored",
      "ownerApproved": "2026-11-06",
      "authoredScope": "npc",
      "reviewNote": "Staff line, standard phrasing used at a till after payment. Authored for this app; no standalone Tatoeba sentence (GAPS.md).",
      "noteKo": "ございました는 과거형이지만 '이용해 주셔서 감사합니다'라는 마무리 인사",
      "audioKey": "c/5315f0c0327b9e9a",
      "key": "authored-882395686e-hear"
    },
    {
      "unitOrd": 3,
      "ord": 22,
      "text": "袋お願いします。",
      "kana": "ふくろおねがいします。",
      "cueKo": "봉투를 달라고 말하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "authored",
      "ownerApproved": "2026-11-06",
      "authoredScope": "spoken",
      "reviewNote": "Learner reply, standard phrasing at a convenience-store till. Authored for this app; no standalone Tatoeba sentence (GAPS.md).",
      "noteKo": "조사 を를 줄여서 말하는 것이 자연스러운 구어 (袋をお願いします)",
      "audioKey": "c/9cec79002bfe7fea",
      "key": "authored-ef6eeb55c5-say"
    },
    {
      "unitOrd": 3,
      "ord": 23,
      "text": "温めてください。",
      "kana": "あたためてください。",
      "cueKo": "도시락을 데워 달라고 말하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "authored",
      "ownerApproved": "2026-11-06",
      "authoredScope": "spoken",
      "reviewNote": "Learner reply, standard phrasing at a convenience-store till. Authored for this app; no standalone Tatoeba sentence (GAPS.md).",
      "noteKo": "〜てください는 '〜해 주세요'. 温める는 '데우다'",
      "audioKey": "c/532d53a38d0e8fed",
      "key": "authored-82d0dfb9ba-say"
    },
    {
      "unitOrd": 3,
      "ord": 24,
      "text": "現金でお願いします。",
      "kana": "げんきんでおねがいします。",
      "cueKo": "현금으로 계산하겠다고 말하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "authored",
      "ownerApproved": "2026-11-06",
      "authoredScope": "spoken",
      "reviewNote": "Learner reply, standard phrasing at a convenience-store till. Authored for this app; no standalone Tatoeba sentence (GAPS.md).",
      "noteKo": "で는 수단 '〜로'. カードで와 같은 틀",
      "audioKey": "c/5a7cd140985bea4a",
      "key": "authored-2923263b22-say"
    }
  ],
