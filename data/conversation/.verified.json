{
  "4704": {
    "text": "何してるの？",
    "sourceAuthor": "Swift"
  },
  "4751": {
    "text": "本当？",
    "sourceAuthor": "bunbuku"
  },
  "5323": {
    "text": "どこから来ましたか？",
    "sourceAuthor": "bunbuku"
  },
  "76355": {
    "text": "違う違う。オリジナリティがあるっていうか。",
    "sourceAuthor": "Sim5634"
  },
  "76406": {
    "text": "またお越しください。",
    "sourceAuthor": "mookeee"
  },
  "76792": {
    "text": "カレーはまあまあでした。",
    "sourceAuthor": "mookeee"
  },
  "78112": {
    "text": "了解しました。",
    "sourceAuthor": "mookeee"
  },
  "78157": {
    "text": "旅行は楽しかったですか。",
    "sourceAuthor": "tommy_san"
  },
  "78645": {
    "text": "来週の日曜なら空いてます。",
    "sourceAuthor": "bunbuku"
  },
  "78991": {
    "text": "予約したいんですが。",
    "sourceAuthor": "bunbuku"
  },
  "81536": {
    "text": "本当にびっくりした。",
    "sourceAuthor": "small_snow"
  },
  "83847": {
    "text": "払い戻しはどうしたらいいのですか。",
    "sourceAuthor": "small_snow"
  },
  "83973": {
    "text": "風邪に効く薬はありますか。",
    "sourceAuthor": "bunbuku"
  },
  "83981": {
    "text": "風邪ですね。",
    "sourceAuthor": "bunbuku"
  },
  "85506": {
    "text": "鼻水が出ます。",
    "sourceAuthor": "bunbuku"
  },
  "121901": {
    "text": "熱があるんです。",
    "sourceAuthor": "tommy_san"
  },
  "122305": {
    "text": "日本食はお好きですか。",
    "sourceAuthor": "bunbuku"
  },
  "122364": {
    "text": "日本語がお上手ですね。",
    "sourceAuthor": "bunbuku"
  },
  "122379": {
    "text": "日本をどう思いますか。",
    "sourceAuthor": "arnab"
  },
  "122452": {
    "text": "日本は初めてですか。",
    "sourceAuthor": "arnab"
  },
  "122503": {
    "text": "日本はどうですか。",
    "sourceAuthor": "small_snow"
  },
  "122693": {
    "text": "日本に来てから十年になります。",
    "sourceAuthor": "small_snow"
  },
  "122696": {
    "text": "日本に来てどれくらいになりますか？",
    "sourceAuthor": "tommy_san"
  },
  "122731": {
    "text": "日本に来たのは初めてですか。",
    "sourceAuthor": "bunbuku"
  },
  "123360": {
    "text": "突き当たりに郵便局があります。",
    "sourceAuthor": "bunbuku"
  },
  "123461": {
    "text": "特大のサイズはあるんですが、その色のは切らしております。",
    "sourceAuthor": "bunbuku"
  },
  "123616": {
    "text": "道なりに進んで、三つ目の交差点を左に曲がって下さい。",
    "sourceAuthor": "KK_kaku_"
  },
  "123688": {
    "text": "同感です。",
    "sourceAuthor": "wakatyann630"
  },
  "123816": {
    "text": "頭痛に効く薬はありますか。",
    "sourceAuthor": "bunbuku"
  },
  "123865": {
    "text": "頭が痛いんです。頭痛薬がありますか。",
    "sourceAuthor": "small_snow"
  },
  "123866": {
    "text": "頭が痛いんです。",
    "sourceAuthor": "bunbuku"
  },
  "124249": {
    "text": "東京に住んでいます。",
    "sourceAuthor": "bunbuku"
  },
  "124574": {
    "text": "途中で乗り換えが必要ですか。",
    "sourceAuthor": "small_snow"
  },
  "124615": {
    "text": "吐き気がします。",
    "sourceAuthor": "Ianagisacos"
  },
  "124875": {
    "text": "田中は今、席を外しております。",
    "sourceAuthor": "bunbuku"
  },
  "125670": {
    "text": "痛み止めを下さい。",
    "sourceAuthor": "bunbuku"
  },
  "126710": {
    "text": "遅れてすみません。",
    "sourceAuthor": "small_snow"
  },
  "126714": {
    "text": "遅れてごめん。",
    "sourceAuthor": "tommy_san"
  },
  "126779": {
    "text": "池袋駅で乗り換えて下さい。",
    "sourceAuthor": "KK_kaku_"
  },
  "138002": {
    "text": "お大事に。",
    "sourceAuthor": "bunbuku"
  },
  "140886": {
    "text": "全く同感です。",
    "sourceAuthor": "wakatyann630"
  },
  "142022": {
    "text": "雪が降るかもしれません。",
    "sourceAuthor": "arnab"
  },
  "142076": {
    "text": "切符売り場はどこですか。",
    "sourceAuthor": "bunbuku"
  },
  "142566": {
    "text": "青色のはありますか。",
    "sourceAuthor": "tommy__san"
  },
  "144764": {
    "text": "診察券を持って来るのを忘れてしまいました。",
    "sourceAuthor": "bunbuku"
  },
  "144771": {
    "text": "診察しましょう。",
    "sourceAuthor": "bunbuku"
  },
  "145955": {
    "text": "色違いはありませんか。",
    "sourceAuthor": "bunbuku"
  },
  "146179": {
    "text": "乗り換えは必要ですか。",
    "sourceAuthor": "bunbuku"
  },
  "146785": {
    "text": "少し熱が出るかもしれません。",
    "sourceAuthor": "bunbuku"
  },
  "147557": {
    "text": "初めての診察ですか。",
    "sourceAuthor": "bunbuku"
  },
  "148465": {
    "text": "趣味は何ですか。",
    "sourceAuthor": "tommy__san"
  },
  "150259": {
    "text": "次の停車駅はどこですか。",
    "sourceAuthor": "bunbuku"
  },
  "150314": {
    "text": "次の駅で乗り換えですよ。",
    "sourceAuthor": "bunbuku"
  },
  "151002": {
    "text": "試着室はどこですか。",
    "sourceAuthor": "bunbuku"
  },
  "151006": {
    "text": "試着できますか。",
    "sourceAuthor": "bunbuku"
  },
  "151007": {
    "text": "試着してもいいですか。",
    "sourceAuthor": "bunbuku"
  },
  "152203": {
    "text": "私もとても楽しかったです。",
    "sourceAuthor": "bunbuku"
  },
  "153093": {
    "text": "私は病院で働いています。",
    "sourceAuthor": "bunbuku"
  },
  "154725": {
    "text": "日本はとても安全な国だと思います。",
    "sourceAuthor": "small_snow"
  },
  "155923": {
    "text": "私は商社で働いています。",
    "sourceAuthor": "tommy__san"
  },
  "158266": {
    "text": "駅に着いたよ。",
    "sourceAuthor": "small_snow"
  },
  "158373": {
    "text": "私は映画が好きです。",
    "sourceAuthor": "tommy_san"
  },
  "160455": {
    "text": "私はそうは思いません。",
    "sourceAuthor": "tommy_san"
  },
  "164201": {
    "text": "私のコーヒーには砂糖を入れないでください。",
    "sourceAuthor": "small_snow"
  },
  "164480": {
    "text": "私にも同じものをください。",
    "sourceAuthor": "bunbuku"
  },
  "169347": {
    "text": "散歩しませんか。",
    "sourceAuthor": "bunbuku"
  },
  "172084": {
    "text": "今度また誘ってよ。",
    "sourceAuthor": "bunbuku"
  },
  "172144": {
    "text": "今度の土曜日はどうですか。",
    "sourceAuthor": "bunbuku"
  },
  "173825": {
    "text": "喉が痛いんです。",
    "sourceAuthor": "bunbuku"
  },
  "174351": {
    "text": "後でまた電話します。",
    "sourceAuthor": "small_snow"
  },
  "175045": {
    "text": "元気？",
    "sourceAuthor": "bunbuku"
  },
  "175593": {
    "text": "月曜日は都合が悪いんです。",
    "sourceAuthor": "bunbuku"
  },
  "175785": {
    "text": "結構面白い。",
    "sourceAuthor": "small_snow"
  },
  "179494": {
    "text": "空いてる席はありますか。",
    "sourceAuthor": "bunbuku"
  },
  "179594": {
    "text": "銀行で働いています。",
    "sourceAuthor": "small_snow"
  },
  "184226": {
    "text": "学生割引はありますか。",
    "sourceAuthor": "tommy_san"
  },
  "184550": {
    "text": "覚えてる？",
    "sourceAuthor": "small_snow"
  },
  "184712": {
    "text": "咳が出ますか。",
    "sourceAuthor": "bunbuku"
  },
  "185076": {
    "text": "海外には行ったことがありません。",
    "sourceAuthor": "small_snow"
  },
  "185455": {
    "text": "会えて嬉しいよ。",
    "sourceAuthor": "bunbuku"
  },
  "187448": {
    "text": "何時にどこで待ち合わせする？",
    "sourceAuthor": "bunbuku"
  },
  "187455": {
    "text": "何時にしましょうか。",
    "sourceAuthor": "small_snow"
  },
  "188169": {
    "text": "何があったの？",
    "sourceAuthor": "bunbuku"
  },
  "188894": {
    "text": "駅はどこですか。",
    "sourceAuthor": "bunbuku"
  },
  "189286": {
    "text": "映画見に行かない？",
    "sourceAuthor": "mookeee"
  },
  "189297": {
    "text": "映画を見に行きませんか。",
    "sourceAuthor": "bunbuku"
  },
  "189616": {
    "text": "雨に降られてぬれちゃったよ。",
    "sourceAuthor": "bunbuku"
  },
  "190532": {
    "text": "一緒に行かない？",
    "sourceAuthor": "bunbuku"
  },
  "190671": {
    "text": "一休みしませんか。",
    "sourceAuthor": "tommy_san"
  },
  "191216": {
    "text": "以上ですか？",
    "sourceAuthor": "small_snow"
  },
  "191499": {
    "text": "悪いけど行けないよ。",
    "sourceAuthor": "bunbuku"
  },
  "193061": {
    "text": "やっと着いた。",
    "sourceAuthor": "small_snow"
  },
  "193236": {
    "text": "もっと大きいサイズはありますか。",
    "sourceAuthor": "bunbuku"
  },
  "193799": {
    "text": "もしもし、ジョンソンさんをお願いします。",
    "sourceAuthor": "KK_kaku_"
  },
  "194081": {
    "text": "もう少し待ってください。",
    "sourceAuthor": "bunbuku"
  },
  "194094": {
    "text": "もう少し小さいのはありますか。",
    "sourceAuthor": "small_snow"
  },
  "194099": {
    "text": "もう少し考えてみます。",
    "sourceAuthor": "small_snow"
  },
  "194123": {
    "text": "もう少しゆっくりお願いします。",
    "sourceAuthor": "small_snow"
  },
  "196236": {
    "text": "ホットドッグを２個、辛子とケチャップつきでおねがいします。",
    "sourceAuthor": "bunbuku"
  },
  "196433": {
    "text": "ほかのを見せてください。",
    "sourceAuthor": "bunbuku"
  },
  "197456": {
    "text": "ビニール袋に入れてください。",
    "sourceAuthor": "small_snow"
  },
  "198059": {
    "text": "バス乗り場はどこですか。",
    "sourceAuthor": "bunbuku"
  },
  "198336": {
    "text": "はい、とても好きです。",
    "sourceAuthor": "small_snow"
  },
  "198378": {
    "text": "はい、行きましょう。",
    "sourceAuthor": "small_snow"
  },
  "199402": {
    "text": "どんな症状がありますか。",
    "sourceAuthor": "bunbuku"
  },
  "200370": {
    "text": "どのような症状ですか。",
    "sourceAuthor": "bunbuku"
  },
  "200548": {
    "text": "とても良かったです。また行きたいですね。",
    "sourceAuthor": "mookeee"
  },
  "200632": {
    "text": "とても楽しかったです。",
    "sourceAuthor": "small_snow"
  },
  "200771": {
    "text": "どちらのご出身ですか？",
    "sourceAuthor": "tommy_san"
  },
  "200777": {
    "text": "どちらにお住まいですか。",
    "sourceAuthor": "bunbuku"
  },
  "200952": {
    "text": "どこで待ち合わせしようか。",
    "sourceAuthor": "tommy_san"
  },
  "200953": {
    "text": "どこで待ち合わせしましょうか。",
    "sourceAuthor": "bunbuku"
  },
  "201342": {
    "text": "どうぞお大事に。",
    "sourceAuthor": "bunbuku"
  },
  "201705": {
    "text": "どういう意味ですか？",
    "sourceAuthor": "tommy_san"
  },
  "202713": {
    "text": "ちょっと無理ですね。",
    "sourceAuthor": "bunbuku"
  },
  "202737": {
    "text": "ちょっと待ってて。",
    "sourceAuthor": "small_snow"
  },
  "205018": {
    "text": "全部で三千円です。",
    "sourceAuthor": "KK_kaku_"
  },
  "205194": {
    "text": "それは困ったね。",
    "sourceAuthor": "tommy__san"
  },
  "205459": {
    "text": "それはちょっと極端じゃないですか。",
    "sourceAuthor": "small_snow"
  },
  "213601": {
    "text": "そこへはどうやって行けばよいですか。",
    "sourceAuthor": "bunbuku"
  },
  "213776": {
    "text": "そう思いませんか。",
    "sourceAuthor": "KK_kaku_"
  },
  "213817": {
    "text": "そうは思いません。",
    "sourceAuthor": "Ianagisacos"
  },
  "214165": {
    "text": "もう一度お願いします。",
    "sourceAuthor": "bunbuku"
  },
  "214191": {
    "text": "すみません、通してください。",
    "sourceAuthor": "bunbuku"
  },
  "214192": {
    "text": "すみません、道に迷ってしまいました。",
    "sourceAuthor": "small_snow"
  },
  "214201": {
    "text": "すみません、もう一度言っていただけますか。",
    "sourceAuthor": "tommy__san"
  },
  "214202": {
    "text": "すみません、もう一度ゆっくり言ってください。",
    "sourceAuthor": "bunbuku"
  },
  "214525": {
    "text": "スプーンをいただけますか。",
    "sourceAuthor": "bunbuku"
  },
  "214729": {
    "text": "すごいじゃん。",
    "sourceAuthor": "bunbuku"
  },
  "214829": {
    "text": "すぐに分かりますよ。",
    "sourceAuthor": "small_snow"
  },
  "216819": {
    "text": "サッカーが一番好きです。",
    "sourceAuthor": "bunbuku"
  },
  "217064": {
    "text": "ご注文はお決まりですか？",
    "sourceAuthor": "tommy_san"
  },
  "217209": {
    "text": "ご一緒に食事でもしませんか。",
    "sourceAuthor": "bunbuku"
  },
  "217643": {
    "text": "これを試着したいのですが。",
    "sourceAuthor": "bunbuku"
  },
  "218300": {
    "text": "これは私が注文したものと違います。",
    "sourceAuthor": "bunbuku"
  },
  "220292": {
    "text": "この道をまっすぐ行ってください。",
    "sourceAuthor": "tommy_san"
  },
  "222064": {
    "text": "この言葉はどういう意味ですか。",
    "sourceAuthor": "mookeee"
  },
  "224277": {
    "text": "ここは免税店ですか。",
    "sourceAuthor": "bunbuku"
  },
  "224546": {
    "text": "ここで食べます。",
    "sourceAuthor": "Ianagisacos"
  },
  "224770": {
    "text": "ここから駅までどのくらいかかりますか。",
    "sourceAuthor": "mookeee"
  },
  "224884": {
    "text": "コーヒーをください。",
    "sourceAuthor": "bunbuku"
  },
  "224907": {
    "text": "コーヒーにはミルクをたくさん入れて下さい。",
    "sourceAuthor": "bunbuku"
  },
  "226472": {
    "text": "カードは使えますか。",
    "sourceAuthor": "small_snow"
  },
  "226474": {
    "text": "カードでお願いします。",
    "sourceAuthor": "small_snow"
  },
  "226565": {
    "text": "お名前をお願いします。",
    "sourceAuthor": "mookeee"
  },
  "226572": {
    "text": "お名前は？",
    "sourceAuthor": "bunbuku"
  },
  "226801": {
    "text": "お湯が出ません。",
    "sourceAuthor": "Ianagisacos"
  },
  "226907": {
    "text": "お待たせしました。",
    "sourceAuthor": "bunbuku"
  },
  "226990": {
    "text": "お先にどうぞ。",
    "sourceAuthor": "bunbuku"
  },
  "227004": {
    "text": "お水をください。",
    "sourceAuthor": "bunbuku"
  },
  "227085": {
    "text": "お取り寄せいたしましょうか。",
    "sourceAuthor": "bunbuku"
  },
  "227101": {
    "text": "お持ち帰りですか。",
    "sourceAuthor": "bunbuku"
  },
  "227125": {
    "text": "お仕事は何ですか。",
    "sourceAuthor": "bunbuku"
  },
  "227370": {
    "text": "お会計はレジでお願いします。",
    "sourceAuthor": "bunbuku"
  },
  "227376": {
    "text": "お会いできて嬉しいです。",
    "sourceAuthor": "bunbuku"
  },
  "227685": {
    "text": "おすすめの料理は何ですか。",
    "sourceAuthor": "bunbuku"
  },
  "227687": {
    "text": "おすすめは何ですか。",
    "sourceAuthor": "bunbuku"
  },
  "227962": {
    "text": "えっ嘘でしょ。",
    "sourceAuthor": "ITA"
  },
  "228001": {
    "text": "えー、信じらんなーい！",
    "sourceAuthor": "tommy__san"
  },
  "228005": {
    "text": "ええ、喜んで。",
    "sourceAuthor": "small_snow"
  },
  "228006": {
    "text": "ええ、わたしもそう思います。",
    "sourceAuthor": "bunbuku"
  },
  "228460": {
    "text": "いらっしゃいませ、何名様ですか。",
    "sourceAuthor": "small_snow"
  },
  "228624": {
    "text": "いつ都合がいいですか。",
    "sourceAuthor": "small_snow"
  },
  "229316": {
    "text": "いえ、結構です。",
    "sourceAuthor": "bunbuku"
  },
  "234833": {
    "text": "ＪＲの駅まで歩いて何分くらいかかりますか。",
    "sourceAuthor": "mookeee"
  },
  "235060": {
    "text": "６時に４人予約したいのですが。",
    "sourceAuthor": "bunbuku"
  },
  "335372": {
    "text": "おはようございます。",
    "sourceAuthor": "Aurix"
  },
  "338114": {
    "text": "いらっしゃいませ。",
    "sourceAuthor": "shiboy"
  },
  "349070": {
    "text": "分かりません。",
    "sourceAuthor": "zipangu"
  },
  "350727": {
    "text": "駅まで歩いて10分ぐらいかかります。",
    "sourceAuthor": "zipangu"
  },
  "373351": {
    "text": "こんにちは。",
    "sourceAuthor": "tommy_san"
  },
  "385517": {
    "text": "もしもし。",
    "sourceAuthor": "mookeee"
  },
  "400933": {
    "text": "お元気ですか。",
    "sourceAuthor": "e4zh1nmcz"
  },
  "408295": {
    "text": "どういたしまして。",
    "sourceAuthor": "bunbuku"
  },
  "408301": {
    "text": "すみません。",
    "sourceAuthor": "bunbuku"
  },
  "417004": {
    "text": "久しぶりだね。",
    "sourceAuthor": "bunbuku"
  },
  "431679": {
    "text": "京都に行ったことありますか？",
    "sourceAuthor": "aliene"
  },
  "507553": {
    "text": "失礼します。",
    "sourceAuthor": "orzage"
  },
  "509772": {
    "text": "はい。",
    "sourceAuthor": "e4zh1nmcz"
  },
  "518581": {
    "text": "なんの問題もないじゃないですか。",
    "sourceAuthor": "nihonjin"
  },
  "536720": {
    "text": "嘘！",
    "sourceAuthor": "tomkun01"
  },
  "536751": {
    "text": "趣味は読書です。",
    "sourceAuthor": "tomkun01"
  },
  "605858": {
    "text": "まじで？",
    "sourceAuthor": "voodoo"
  },
  "628692": {
    "text": "本当だよ！",
    "sourceAuthor": "satosi"
  },
  "629009": {
    "text": "申し訳ありませんが、在庫がありません。",
    "sourceAuthor": "blay_paul"
  },
  "688395": {
    "text": "お疲れ様でした。",
    "sourceAuthor": "arihato"
  },
  "762125": {
    "text": "了解。",
    "sourceAuthor": "arihato"
  },
  "774500": {
    "text": "後ほど私に電話をするよう彼女に伝えていただけますか？",
    "sourceAuthor": "marloncori"
  },
  "774502": {
    "text": "電話番号を伺えますか？",
    "sourceAuthor": "marloncori"
  },
  "778160": {
    "text": "日本語がとても好きです。",
    "sourceAuthor": "windra"
  },
  "889706": {
    "text": "申し訳ありません。田中は今、席を外しております。",
    "sourceAuthor": "bunbuku"
  },
  "921333": {
    "text": "外国に行ったことがあります。",
    "sourceAuthor": "riccioberto"
  },
  "926739": {
    "text": "お願いします。",
    "sourceAuthor": "riccioberto"
  },
  "975671": {
    "text": "日本語を勉強しています。",
    "sourceAuthor": "ultrasaurus"
  },
  "1014812": {
    "text": "お会計お願いします。",
    "sourceAuthor": "mookeee"
  },
  "1022297": {
    "text": "すみません、注文お願いします。",
    "sourceAuthor": "mookeee"
  },
  "1031930": {
    "text": "申し訳ありません。田中は今、手が離せないので、後でこちらから電話します。",
    "sourceAuthor": "bunbuku"
  },
  "1035010": {
    "text": "どうやって海岸に行けばいいですか。",
    "sourceAuthor": "bunbuku"
  },
  "1035020": {
    "text": "いつかフランスに行ってみたいです。",
    "sourceAuthor": "bunbuku"
  },
  "1046244": {
    "text": "数分遅れるかもしれません。",
    "sourceAuthor": "bunbuku"
  },
  "1059896": {
    "text": "今日の夜、空いてる？",
    "sourceAuthor": "bunbuku"
  },
  "1064324": {
    "text": "ちょっと待って。",
    "sourceAuthor": "bunbuku"
  },
  "1125025": {
    "text": "旅行は好きですか？",
    "sourceAuthor": "mookeee"
  },
  "1126049": {
    "text": "先生、お腹が痛いんです。",
    "sourceAuthor": "bunbuku"
  },
  "1139064": {
    "text": "昔の友達をそこで見て驚いたよ。",
    "sourceAuthor": "bunbuku"
  },
  "1151905": {
    "text": "３名で予約をお願いしたいんですが。",
    "sourceAuthor": "mookeee"
  },
  "1166625": {
    "text": "うん。",
    "sourceAuthor": "bunbuku"
  },
  "1166626": {
    "text": "ええ。",
    "sourceAuthor": "bunbuku"
  },
  "1168408": {
    "text": "日本の食べ物を食べたことがありますか。",
    "sourceAuthor": "bunbuku"
  },
  "1185759": {
    "text": "喉が痛くて微熱があるんです。",
    "sourceAuthor": "bunbuku"
  },
  "1189862": {
    "text": "私は日本語が少し話せますが、まだ上手じゃありません。",
    "sourceAuthor": "FiRez"
  },
  "1270752": {
    "text": "それはひどいな。",
    "sourceAuthor": "bunbuku"
  },
  "1483682": {
    "text": "申し訳ございません。",
    "sourceAuthor": "marshmallowcat"
  },
  "1483688": {
    "text": "こちらへどうぞ。",
    "sourceAuthor": "marshmallowcat"
  },
  "1528157": {
    "text": "ローマに行ったことがあります。",
    "sourceAuthor": "bunbuku"
  },
  "1531875": {
    "text": "ありがとう！",
    "sourceAuthor": "cc_neko"
  },
  "1556116": {
    "text": "ごめん、忘れちゃった。",
    "sourceAuthor": "bunbuku"
  },
  "1614410": {
    "text": "コーヒーを一杯とクロワッサンをひとつ下さい。",
    "sourceAuthor": "Meow"
  },
  "1680694": {
    "text": "どうでしたか？",
    "sourceAuthor": "aka_aj"
  },
  "1815853": {
    "text": "誰かが何か言ったんだけど、わかんなかった。",
    "sourceAuthor": "bunbuku"
  },
  "1937825": {
    "text": "大丈夫ですか。",
    "sourceAuthor": "agro1986"
  },
  "2041004": {
    "text": "楽しみにしています。",
    "sourceAuthor": "bunbuku"
  },
  "2063335": {
    "text": "折り返し電話します。",
    "sourceAuthor": "bunbuku"
  },
  "2097872": {
    "text": "イヤリングを片方失くしたんです。",
    "sourceAuthor": "bunbuku"
  },
  "2135770": {
    "text": "もっと安いのはありますか。",
    "sourceAuthor": "bunbuku"
  },
  "2137193": {
    "text": "ビールはあまり好きではありません。",
    "sourceAuthor": "bunbuku"
  },
  "2151547": {
    "text": "二番目の角を右に曲がってください。",
    "sourceAuthor": "Blanka_Meduzo"
  },
  "2154940": {
    "text": "以上です。",
    "sourceAuthor": "bunbuku"
  },
  "2179000": {
    "text": "日本に行ったことがありますか。",
    "sourceAuthor": "abbymae111"
  },
  "2179015": {
    "text": "敬語というのは日本語の一番難しいところだと思います。",
    "sourceAuthor": "abbymae111"
  },
  "2196376": {
    "text": "どうしたの。",
    "sourceAuthor": "bunbuku"
  },
  "2233267": {
    "text": "すみません、お箸を落としてしまったんですが。",
    "sourceAuthor": "tommy_san"
  },
  "2237943": {
    "text": "私の趣味は写真です。",
    "sourceAuthor": "tommy_san"
  },
  "2251469": {
    "text": "分かった。",
    "sourceAuthor": "DiePain"
  },
  "2255796": {
    "text": "これは注文と違います。",
    "sourceAuthor": "tommy_san"
  },
  "2265623": {
    "text": "これ、買います。",
    "sourceAuthor": "Ianagisacos"
  },
  "2265633": {
    "text": "お飲み物は何にしますか。",
    "sourceAuthor": "Ianagisacos"
  },
  "2265662": {
    "text": "これにします。",
    "sourceAuthor": "Ianagisacos"
  },
  "2270834": {
    "text": "処方箋をお出しします。",
    "sourceAuthor": "tommy_san"
  },
  "2304911": {
    "text": "大丈夫です。",
    "sourceAuthor": "bunbuku"
  },
  "2350395": {
    "text": "なるほど。",
    "sourceAuthor": "hutian"
  },
  "2374996": {
    "text": "見たことがあります。",
    "sourceAuthor": "wakatyann630"
  },
  "2413229": {
    "text": "見てるだけです。",
    "sourceAuthor": "tommy_san"
  },
  "2436329": {
    "text": "六時はどうですか。",
    "sourceAuthor": "fgreco"
  },
  "2459210": {
    "text": "ごめん、20分くらい遅れるかも。",
    "sourceAuthor": "tommy_san"
  },
  "2519008": {
    "text": "すみません、聞こえませんでした。",
    "sourceAuthor": "tommy_san"
  },
  "2519088": {
    "text": "郵便局への行き方を教えてください。",
    "sourceAuthor": "tommy_san"
  },
  "2569603": {
    "text": "起きてる？",
    "sourceAuthor": "tommy_san"
  },
  "2708994": {
    "text": "郵便局はふたつ先の信号を右です。",
    "sourceAuthor": "nhanquinho"
  },
  "2724966": {
    "text": "沖縄に行ったことはありますか？",
    "sourceAuthor": "tommy_san"
  },
  "2744751": {
    "text": "そうなんですか？",
    "sourceAuthor": "tommy_san"
  },
  "2790222": {
    "text": "すみません、駅への道を教えていただけませんか？",
    "sourceAuthor": "tommy_san"
  },
  "2838403": {
    "text": "何かアレルギーはありますか？",
    "sourceAuthor": "tommy_san"
  },
  "2863727": {
    "text": "かしこまりました。確認致しますので、少々お待ち頂けますか。",
    "sourceAuthor": "Nekonari"
  },
  "2869738": {
    "text": "これ試着してもいいですか？",
    "sourceAuthor": "tommy_san"
  },
  "2903638": {
    "text": "こちらの書類にご記入ください。",
    "sourceAuthor": "tommy_san"
  },
  "2904021": {
    "text": "ごめんちょっと遅れる。3時10分には着くと思う。",
    "sourceAuthor": "tommy_san"
  },
  "2912698": {
    "text": "全くおっしゃる通りです。",
    "sourceAuthor": "tommy_san"
  },
  "2929527": {
    "text": "すみません、何とおっしゃいましたか？",
    "sourceAuthor": "tommy_san"
  },
  "2930030": {
    "text": "そんなに感謝されると逆にこっちが恐縮しちゃうよ。",
    "sourceAuthor": "tommy_san"
  },
  "2976202": {
    "text": "読書がとても好きです。",
    "sourceAuthor": "Fukuko"
  },
  "3024516": {
    "text": "今週末は暇？",
    "sourceAuthor": "tommy_san"
  },
  "3126037": {
    "text": "明日楽しみだな。",
    "sourceAuthor": "tommy_san"
  },
  "3190694": {
    "text": "お仕事は何をなさってるんですか？",
    "sourceAuthor": "tommy_san"
  },
  "3190698": {
    "text": "お仕事は何をされているんですか？",
    "sourceAuthor": "tommy__san"
  },
  "3241575": {
    "text": "やばい、宿題やってない。",
    "sourceAuthor": "tommy_san"
  },
  "3247983": {
    "text": "今週末空いてる？",
    "sourceAuthor": "tommy_san"
  },
  "3262066": {
    "text": "タメでいいよ。",
    "sourceAuthor": "tommy_san"
  },
  "3326577": {
    "text": "会社員です。",
    "sourceAuthor": "boscowitch"
  },
  "3395375": {
    "text": "昨日何時に寝た？",
    "sourceAuthor": "tommy_san"
  },
  "3400864": {
    "text": "趣味は音楽鑑賞です。",
    "sourceAuthor": "tommy_san"
  },
  "3401024": {
    "text": "お電話ありがとうございます。",
    "sourceAuthor": "arnab"
  },
  "3452051": {
    "text": "お勘定お願いします。",
    "sourceAuthor": "tommy_san"
  },
  "3452060": {
    "text": "今日の夜予定ある？",
    "sourceAuthor": "tommy_san"
  },
  "3495032": {
    "text": "元気です。",
    "sourceAuthor": "arnab"
  },
  "3495530": {
    "text": "冗談でしょ？",
    "sourceAuthor": "arnab"
  },
  "3496720": {
    "text": "本当なんじゃないですか？",
    "sourceAuthor": "arnab"
  },
  "3507395": {
    "text": "分かりますか？",
    "sourceAuthor": "arnab"
  },
  "3515218": {
    "text": "ポイントカードはお持ちですか？",
    "sourceAuthor": "tommy_san"
  },
  "3549611": {
    "text": "出口はどこですか？",
    "sourceAuthor": "tommy_san"
  },
  "3554821": {
    "text": "めまいがします。",
    "sourceAuthor": "tommy__san"
  },
  "3554825": {
    "text": "この近くに薬局はありますか？",
    "sourceAuthor": "tommy_san"
  },
  "3555502": {
    "text": "何かお探しですか？",
    "sourceAuthor": "arnab"
  },
  "3580937": {
    "text": "私はエンジニアです。",
    "sourceAuthor": "e4zh1nmcz"
  },
  "3595025": {
    "text": "ご予約はされていますか？",
    "sourceAuthor": "arnab"
  },
  "3597438": {
    "text": "大きな声で言って。聞こえないよ。",
    "sourceAuthor": "arnab"
  },
  "3613713": {
    "text": "よくお似合いです。",
    "sourceAuthor": "arnab"
  },
  "3621802": {
    "text": "あっ、ごめんなさい。",
    "sourceAuthor": "arnab"
  },
  "3753221": {
    "text": "疲れちゃったの？",
    "sourceAuthor": "e4zh1nmcz"
  },
  "3878008": {
    "text": "手伝おうか？",
    "sourceAuthor": "tommy_san"
  },
  "4002020": {
    "text": "私もそう思います。",
    "sourceAuthor": "oliviya"
  },
  "4270214": {
    "text": "旅行はどうでしたか？",
    "sourceAuthor": "tommy_san"
  },
  "4562480": {
    "text": "もう一度言ってください。",
    "sourceAuthor": "Kiraness"
  },
  "4621452": {
    "text": "これは何ですか？",
    "sourceAuthor": "xDestroyerVx"
  },
  "4632701": {
    "text": "禁煙席をお願いします。",
    "sourceAuthor": "verbum"
  },
  "4651964": {
    "text": "おっしゃる通りです。",
    "sourceAuthor": "tommy_san"
  },
  "4694697": {
    "text": "何名様ですか。",
    "sourceAuthor": "wells"
  },
  "4751193": {
    "text": "旅行どうでしたか？",
    "sourceAuthor": "tommy_san"
  },
  "4751197": {
    "text": "どうでした、旅行は？",
    "sourceAuthor": "tommy_san"
  },
  "4769881": {
    "text": "次の角を右に曲がってください。",
    "sourceAuthor": "tommy_san"
  },
  "4865664": {
    "text": "今どこにいるの？",
    "sourceAuthor": "tommy_san"
  },
  "5719676": {
    "text": "咳が出ます。",
    "sourceAuthor": "saturo"
  },
  "5762757": {
    "text": "何時に出る？",
    "sourceAuthor": "daifons"
  },
  "5955917": {
    "text": "そうですか。",
    "sourceAuthor": "tatoebane"
  },
  "5955920": {
    "text": "そうなんだ。",
    "sourceAuthor": "tatoebane"
  },
  "5955970": {
    "text": "とんでもありません！",
    "sourceAuthor": "tatoebane"
  },
  "6137181": {
    "text": "私は食べたことがありません。",
    "sourceAuthor": "Sethlang"
  },
  "8424881": {
    "text": "折り返しご連絡いたします。",
    "sourceAuthor": "small_snow"
  },
  "8504258": {
    "text": "いいね。",
    "sourceAuthor": "kamojun"
  },
  "8576120": {
    "text": "紅茶をください。",
    "sourceAuthor": "small_snow"
  },
  "8583430": {
    "text": "これください。",
    "sourceAuthor": "bunbuku"
  },
  "8584140": {
    "text": "私も賛成です。",
    "sourceAuthor": "bunbuku"
  },
  "8655526": {
    "text": "これ包んでもらえますか？",
    "sourceAuthor": "bunbuku"
  },
  "8688962": {
    "text": "びっくりした？",
    "sourceAuthor": "small_snow"
  },
  "8692850": {
    "text": "ソウルに住んでいます。",
    "sourceAuthor": "small_snow"
  },
  "8692860": {
    "text": "韓国人です。",
    "sourceAuthor": "small_snow"
  },
  "8720989": {
    "text": "基本的には賛成です。",
    "sourceAuthor": "small_snow"
  },
  "8728239": {
    "text": "郵便局はこの近くですか？",
    "sourceAuthor": "bunbuku"
  },
  "8755532": {
    "text": "動物園はこの近くですか？",
    "sourceAuthor": "bunbuku"
  },
  "8795518": {
    "text": "ゆっくり話してください。",
    "sourceAuthor": "dotheduyet1999"
  },
  "8802478": {
    "text": "で、あなたは？",
    "sourceAuthor": "small_snow"
  },
  "8814342": {
    "text": "明日の夜って空いてる？",
    "sourceAuthor": "bunbuku"
  },
  "8815926": {
    "text": "今現在、何か飲んでいる薬はありますか？",
    "sourceAuthor": "bunbuku"
  },
  "8842211": {
    "text": "明日は月曜だよね。",
    "sourceAuthor": "small_snow"
  },
  "8866543": {
    "text": "こちらに氏名・住所・電話番号をご記入ください。",
    "sourceAuthor": "small_snow"
  },
  "8875105": {
    "text": "お茶でもどうですか？",
    "sourceAuthor": "small_snow"
  },
  "8886173": {
    "text": "少々お待ちください。",
    "sourceAuthor": "small_snow"
  },
  "8969092": {
    "text": "いつなら空いてる？",
    "sourceAuthor": "bunbuku"
  },
  "9041998": {
    "text": "語学学校で働いています。",
    "sourceAuthor": "Ninja"
  },
  "9043414": {
    "text": "どちらからいらしたんですか？",
    "sourceAuthor": "bunbuku"
  },
  "9046236": {
    "text": "観光で来てるんです。",
    "sourceAuthor": "bunbuku"
  },
  "9073662": {
    "text": "最寄りの駅はどこですか？",
    "sourceAuthor": "small_snow"
  },
  "9083377": {
    "text": "ちょっと見てるだけなので、大丈夫です。",
    "sourceAuthor": "bunbuku"
  },
  "9112549": {
    "text": "早いじゃん。",
    "sourceAuthor": "bunbuku"
  },
  "9194721": {
    "text": "今そっちに向かってるとこ。",
    "sourceAuthor": "small_snow"
  },
  "9203476": {
    "text": "こちらでお召し上がりですか？それともお持ち帰りですか？",
    "sourceAuthor": "bunbuku"
  },
  "9420495": {
    "text": "夜ご飯、食べに行かない？",
    "sourceAuthor": "bunbuku"
  },
  "9457856": {
    "text": "家に帰る途中で雨に降られたんだ。",
    "sourceAuthor": "bunbuku"
  },
  "9499960": {
    "text": "いいよ。",
    "sourceAuthor": "small_snow"
  },
  "9540499": {
    "text": "窓際の席でお願いします。",
    "sourceAuthor": "small_snow"
  },
  "9559301": {
    "text": "ありがとうございます。",
    "sourceAuthor": "Sim5634"
  },
  "9573232": {
    "text": "趣味は映画鑑賞です。",
    "sourceAuthor": "Sim5634"
  },
  "9594385": {
    "text": "もしもし、どちら様ですか？",
    "sourceAuthor": "small_snow"
  },
  "9681715": {
    "text": "風邪を引いたみたいなんです。",
    "sourceAuthor": "bunbuku"
  },
  "9681828": {
    "text": "コーヒーのお代わりをお願いします。",
    "sourceAuthor": "bunbuku"
  },
  "9684513": {
    "text": "そういうわけで遅刻しちゃったのよ。",
    "sourceAuthor": "bunbuku"
  },
  "9699149": {
    "text": "はじめまして。",
    "sourceAuthor": "Sim5634"
  },
  "9776974": {
    "text": "金曜日はどうですか？",
    "sourceAuthor": "small_snow"
  },
  "9776980": {
    "text": "月曜日はどうですか？",
    "sourceAuthor": "small_snow"
  },
  "9795497": {
    "text": "サイズはおいくつでしょうか。",
    "sourceAuthor": "bunbuku"
  },
  "9846152": {
    "text": "後で電話するね。",
    "sourceAuthor": "Ninja"
  },
  "9853743": {
    "text": "このバスって動物園で止まりますか？",
    "sourceAuthor": "small_snow"
  },
  "9853946": {
    "text": "ねぇ、ちょっと聞いてよ。",
    "sourceAuthor": "small_snow"
  },
  "9859016": {
    "text": "痛みはいつからですか？",
    "sourceAuthor": "bunbuku"
  },
  "9865994": {
    "text": "目まいがしますか？",
    "sourceAuthor": "bunbuku"
  },
  "9961678": {
    "text": "今日の午後は空いてますか？",
    "sourceAuthor": "small_snow"
  },
  "9964582": {
    "text": "少し休憩しませんか？",
    "sourceAuthor": "small_snow"
  },
  "10000276": {
    "text": "その色いいね。",
    "sourceAuthor": "small_snow"
  },
  "10043066": {
    "text": "先生に診てもらいたいです。",
    "sourceAuthor": "small_snow"
  },
  "10049472": {
    "text": "これの色違いってありますか？",
    "sourceAuthor": "small_snow"
  },
  "10066792": {
    "text": "笑っちゃった。",
    "sourceAuthor": "small_snow"
  },
  "10069965": {
    "text": "行こうかと考えたんだけど、結局行かないことにしたよ。",
    "sourceAuthor": "bunbuku"
  },
  "10070508": {
    "text": "私に何が起こったか聞いてよ。",
    "sourceAuthor": "bunbuku"
  },
  "10079743": {
    "text": "めっちゃびっくりした。",
    "sourceAuthor": "small_snow"
  },
  "10089482": {
    "text": "北海道には一度、行ったことがあります。",
    "sourceAuthor": "small_snow"
  },
  "10100070": {
    "text": "ごちそうさまでした。",
    "sourceAuthor": "small_snow"
  },
  "10111196": {
    "text": "もっと明るい色合いのが欲しいんです。",
    "sourceAuthor": "bunbuku"
  },
  "10171381": {
    "text": "濡れちゃった。",
    "sourceAuthor": "small_snow"
  },
  "10181629": {
    "text": "すみません、地下鉄の駅はどこですか？",
    "sourceAuthor": "small_snow"
  },
  "10203581": {
    "text": "後ほど、ご連絡します。",
    "sourceAuthor": "small_snow"
  },
  "10218817": {
    "text": "家に帰る途中、道に迷ってしまった。",
    "sourceAuthor": "small_snow"
  },
  "10455088": {
    "text": "駅で待ち合わせよう。",
    "sourceAuthor": "bunbuku"
  },
  "10455178": {
    "text": "駅で待ち合わせしようね。",
    "sourceAuthor": "small_snow"
  },
  "10485508": {
    "text": "次の駅で降りてください。",
    "sourceAuthor": "bunbuku"
  },
  "10565813": {
    "text": "どうしたの？大丈夫？",
    "sourceAuthor": "small_snow"
  },
  "10574111": {
    "text": "コーヒー飲みに行かない？",
    "sourceAuthor": "small_snow"
  },
  "10588666": {
    "text": "今日はどうされましたか。",
    "sourceAuthor": "Sonata"
  },
  "10602871": {
    "text": "待たせて、ごめんね。",
    "sourceAuthor": "small_snow"
  },
  "10605827": {
    "text": "もっと大きな声でお願いします。",
    "sourceAuthor": "small_snow"
  },
  "10607397": {
    "text": "麺類が好きです。",
    "sourceAuthor": "small_snow"
  },
  "10614923": {
    "text": "冗談だよね？",
    "sourceAuthor": "small_snow"
  },
  "10630194": {
    "text": "今夜は空いてるよ。",
    "sourceAuthor": "small_snow"
  },
  "10631776": {
    "text": "頭痛がひどくてね。それで早く寝たんだよ。",
    "sourceAuthor": "bunbuku"
  },
  "10647275": {
    "text": "レシートをください。",
    "sourceAuthor": "small_snow"
  },
  "10650485": {
    "text": "ここから動物園までは歩いて行ける距離ですか？",
    "sourceAuthor": "small_snow"
  },
  "10657668": {
    "text": "ごめん、今は無理。",
    "sourceAuthor": "small_snow"
  },
  "10668790": {
    "text": "香港には一度行ったことがありますよ。",
    "sourceAuthor": "small_snow"
  },
  "10669763": {
    "text": "寝坊しちゃって、始発に間に合わなかったんだ。",
    "sourceAuthor": "bunbuku"
  },
  "10677269": {
    "text": "寝坊して、学校に遅刻しちゃったんだ。",
    "sourceAuthor": "bunbuku"
  },
  "10756859": {
    "text": "学生です。",
    "sourceAuthor": "small_snow"
  },
  "10763914": {
    "text": "他のサイズはありますか？",
    "sourceAuthor": "small_snow"
  },
  "10807097": {
    "text": "お支払いは現金ですか？カードですか？",
    "sourceAuthor": "bunbuku"
  },
  "10899609": {
    "text": "昨日、鍵をなくしてしまいました。",
    "sourceAuthor": "small_snow"
  },
  "10899752": {
    "text": "はい、分かりました。",
    "sourceAuthor": "small_snow"
  },
  "10899840": {
    "text": "去年、友達と海外旅行に行きました。",
    "sourceAuthor": "small_snow"
  },
  "10901614": {
    "text": "ちょっと待ってください。",
    "sourceAuthor": "small_snow"
  },
  "10901646": {
    "text": "駅を出て、あの道をまっすぐ行ってください。",
    "sourceAuthor": "small_snow"
  },
  "10901910": {
    "text": "去年より今年のほうが暑いです。",
    "sourceAuthor": "small_snow"
  },
  "10906687": {
    "text": "そうですね。",
    "sourceAuthor": "small_snow"
  },
  "10906691": {
    "text": "今何してる？",
    "sourceAuthor": "small_snow"
  },
  "10906708": {
    "text": "僕もびっくりしたよ。",
    "sourceAuthor": "small_snow"
  },
  "10908859": {
    "text": "昨日、にわか雨に降られたんだ。",
    "sourceAuthor": "bunbuku"
  },
  "10913715": {
    "text": "どう思いますか？",
    "sourceAuthor": "small_snow"
  },
  "10914856": {
    "text": "ええ、いいですよ。",
    "sourceAuthor": "small_snow"
  },
  "10914867": {
    "text": "また後で来ます。",
    "sourceAuthor": "small_snow"
  },
  "10918370": {
    "text": "どうぞよろしくお願いします。",
    "sourceAuthor": "small_snow"
  },
  "10946947": {
    "text": "ですが、いつもそうだとは限りません。",
    "sourceAuthor": "small_snow"
  },
  "10952563": {
    "text": "綺麗だと思います。",
    "sourceAuthor": "small_snow"
  },
  "10982401": {
    "text": "お待ちしております。",
    "sourceAuthor": "small_snow"
  },
  "10983389": {
    "text": "ご連絡お待ちしております。",
    "sourceAuthor": "small_snow"
  },
  "10987738": {
    "text": "確かに今日は涼しいな。",
    "sourceAuthor": "small_snow"
  },
  "11001436": {
    "text": "えーとですね。",
    "sourceAuthor": "small_snow"
  },
  "11021618": {
    "text": "こちらこそ、はじめまして。",
    "sourceAuthor": "small_snow"
  },
  "11021619": {
    "text": "こちらこそ、よろしくお願いします。",
    "sourceAuthor": "small_snow"
  },
  "11041830": {
    "text": "かしこまりました。",
    "sourceAuthor": "small_snow"
  },
  "11054750": {
    "text": "飽きちゃった。",
    "sourceAuthor": "bunbuku"
  },
  "11062662": {
    "text": "お水のおかわりをお願いします。",
    "sourceAuthor": "bunbuku"
  },
  "11075451": {
    "text": "結局、来なかったよ。",
    "sourceAuthor": "small_snow"
  },
  "11129477": {
    "text": "フランス語は難しいと思います。",
    "sourceAuthor": "small_snow"
  },
  "11138356": {
    "text": "ちょっとびっくりした。",
    "sourceAuthor": "small_snow"
  },
  "11243057": {
    "text": "痛い時は、痛み止めを飲んでください。",
    "sourceAuthor": "small_snow"
  },
  "11327855": {
    "text": "意味が分かりませんでした。",
    "sourceAuthor": "small_snow"
  },
  "11368327": {
    "text": "ご試着なさいますか？",
    "sourceAuthor": "bunbuku"
  },
  "11391129": {
    "text": "言葉より行動が大切だと思います。",
    "sourceAuthor": "small_snow"
  },
  "11451491": {
    "text": "何時がご都合よろしいですか？",
    "sourceAuthor": "bunbuku"
  },
  "11469960": {
    "text": "見せてもらえますか？",
    "sourceAuthor": "bunbuku"
  },
  "11488333": {
    "text": "こちらへはお仕事で？それとも観光ですか？",
    "sourceAuthor": "bunbuku"
  },
  "11512359": {
    "text": "知ってる？",
    "sourceAuthor": "megamanenm"
  },
  "11542272": {
    "text": "その角を右に曲がれば、左手にありますよ。",
    "sourceAuthor": "bunbuku"
  },
  "11546070": {
    "text": "結果はどうなったの？",
    "sourceAuthor": "small_snow"
  },
  "11548105": {
    "text": "会計は別々でお願いします。",
    "sourceAuthor": "small_snow"
  },
  "11548108": {
    "text": "別々でお願いします。",
    "sourceAuthor": "small_snow"
  },
  "11561704": {
    "text": "その後どうなるの？",
    "sourceAuthor": "small_snow"
  },
  "11582360": {
    "text": "カードで払いたいんですが。",
    "sourceAuthor": "small_snow"
  },
  "11632729": {
    "text": "うっそ〜！絶対うそだよ！",
    "sourceAuthor": "hidemat"
  },
  "11674920": {
    "text": "目覚ましかけ忘れてて、仕事に遅刻しちゃった。",
    "sourceAuthor": "small_snow"
  },
  "11682757": {
    "text": "昨日、友達が会いに来てくれたんだ。",
    "sourceAuthor": "small_snow"
  },
  "11700536": {
    "text": "こちらがお探しのものでしょうか？",
    "sourceAuthor": "bunbuku"
  },
  "11735233": {
    "text": "とても美味しかったです。",
    "sourceAuthor": "small_snow"
  },
  "11744821": {
    "text": "月曜日は行けないんです。",
    "sourceAuthor": "bunbuku"
  },
  "11890833": {
    "text": "現金でも大丈夫ですか？",
    "sourceAuthor": "small_snow"
  },
  "11906621": {
    "text": "6時半、4人席を予約したいんですが。",
    "sourceAuthor": "small_snow"
  },
  "11909845": {
    "text": "バス停は、ここから歩いて5分です。",
    "sourceAuthor": "small_snow"
  },
  "11953092": {
    "text": "絶対に来た方がいいですよ。",
    "sourceAuthor": "bunbuku"
  },
  "12024147": {
    "text": "レシートはいりません。",
    "sourceAuthor": "small_snow"
  },
  "12148232": {
    "text": "落とし物カウンターはどこですか？",
    "sourceAuthor": "small_snow"
  },
  "12163584": {
    "text": "プレゼント用に包んでもらえますか？",
    "sourceAuthor": "small_snow"
  },
  "12167707": {
    "text": "あっ、びっくりした。",
    "sourceAuthor": "small_snow"
  },
  "12167715": {
    "text": "またのご来店をお待ちしております。",
    "sourceAuthor": "small_snow"
  },
  "12221723": {
    "text": "海外旅行に行ったことはありますか？",
    "sourceAuthor": "small_snow"
  },
  "12304961": {
    "text": "何時がいい？",
    "sourceAuthor": "small_snow"
  },
  "12455624": {
    "text": "さっき、事故っちゃって。",
    "sourceAuthor": "small_snow"
  },
  "12593262": {
    "text": "韓国で生まれました。",
    "sourceAuthor": "small_snow"
  },
  "12593296": {
    "text": "去年、初めてパリに行きました。",
    "sourceAuthor": "small_snow"
  },
  "12712281": {
    "text": "よかったね。",
    "sourceAuthor": "small_snow"
  },
  "12754558": {
    "text": "宿泊先はどうでしたか？",
    "sourceAuthor": "small_snow"
  },
  "12889995": {
    "text": "お名前は何ですか？",
    "sourceAuthor": "small_snow"
  },
  "12890046": {
    "text": "メニューをください。",
    "sourceAuthor": "small_snow"
  },
  "12980599": {
    "text": "昨日、散髪に行ったんだけど、今回のは気に入ったよ。",
    "sourceAuthor": "DJ_Saidez"
  },
  "13055895": {
    "text": "あたりが静かすぎて逆に落ち着かない。",
    "sourceAuthor": "Gardenia"
  },
  "13056492": {
    "text": "財布を家に忘れてしまった。",
    "sourceAuthor": "Gardenia"
  },
  "13059163": {
    "text": "友達におすすめされたラーメン屋に行ってみたら、行列ができていた。",
    "sourceAuthor": "Gardenia"
  },
  "13059187": {
    "text": "家に帰ったらすぐにシャワーを浴びた。",
    "sourceAuthor": "Gardenia"
  },
  "13060586": {
    "text": "先週、新しいレストランに行ってみたら、すごくおいしくて、また行きたくなりました。",
    "sourceAuthor": "Gardenia"
  },
  "13117658": {
    "text": "宜しくお願いします。",
    "sourceAuthor": "atitarev"
  },
  "13117666": {
    "text": "申し訳ありません。",
    "sourceAuthor": "atitarev"
  },
  "13152284": {
    "text": "左に曲がってください。",
    "sourceAuthor": "atitarev"
  },
  "13201460": {
    "text": "次の日は、一歩も歩けなかった。",
    "sourceAuthor": "small_snow"
  },
  "13211669": {
    "text": "ううん。",
    "sourceAuthor": "atitarev"
  },
  "13222205": {
    "text": "先週末は何をしたの？",
    "sourceAuthor": "atitarev"
  },
  "13254274": {
    "text": "音楽が大好きです。",
    "sourceAuthor": "atitarev"
  },
  "13254283": {
    "text": "音楽が好きです。",
    "sourceAuthor": "atitarev"
  },
  "13428548": {
    "text": "驚いたよ！",
    "sourceAuthor": "demiurgastel"
  },
  "13440763": {
    "text": "他のサイズもございますので、お声がけください。",
    "sourceAuthor": "Gardenia"
  },
  "13479171": {
    "text": "カードでお支払いの場合は、こちらのレジへどうぞ。",
    "sourceAuthor": "Gardenia"
  },
  "13479241": {
    "text": "こちら、お客様控えになります。",
    "sourceAuthor": "Gardenia"
  },
  "13523728": {
    "text": "久しぶり！",
    "sourceAuthor": "LeviHighway"
  },
  "13543264": {
    "text": "嘘でしょ……",
    "sourceAuthor": "LeviHighway"
  },
  "13563728": {
    "text": "確かに。",
    "sourceAuthor": "kuwasiku"
  },
  "13640835": {
    "text": "いいですね。",
    "sourceAuthor": "6b"
  },
  "13714023": {
    "text": "領収書をください。",
    "sourceAuthor": "GreySquirrel"
  },
  "13753496": {
    "text": "日本が好きですか？",
    "sourceAuthor": "TanukiKun"
  },
  "13940407": {
    "text": "ホテルで働いています。",
    "sourceAuthor": "small_snow"
  },
  "13985927": {
    "text": "日本語は最も美しい言語の一つです。",
    "sourceAuthor": "TanukiKun"
  },
  "14034470": {
    "text": "今朝は寒いじゃないですか。",
    "sourceAuthor": "LeviHighway"
  },
  "14048807": {
    "text": "ナムと申します。",
    "sourceAuthor": "TanukiKun"
  }
}
