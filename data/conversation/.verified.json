{
  "4704": {
    "text": "何してるの？",
    "sourceAuthor": "Swift"
  },
  "4751": {
    "text": "本当？",
    "sourceAuthor": "bunbuku"
  },
  "5323": {
    "text": "どこから来ましたか？",
    "sourceAuthor": "bunbuku"
  },
  "76406": {
    "text": "またお越しください。",
    "sourceAuthor": "mookeee"
  },
  "76792": {
    "text": "カレーはまあまあでした。",
    "sourceAuthor": "mookeee"
  },
  "78157": {
    "text": "旅行は楽しかったですか。",
    "sourceAuthor": "tommy_san"
  },
  "78645": {
    "text": "来週の日曜なら空いてます。",
    "sourceAuthor": "bunbuku"
  },
  "122305": {
    "text": "日本食はお好きですか。",
    "sourceAuthor": "bunbuku"
  },
  "122364": {
    "text": "日本語がお上手ですね。",
    "sourceAuthor": "bunbuku"
  },
  "122379": {
    "text": "日本をどう思いますか。",
    "sourceAuthor": "arnab"
  },
  "122452": {
    "text": "日本は初めてですか。",
    "sourceAuthor": "arnab"
  },
  "122503": {
    "text": "日本はどうですか。",
    "sourceAuthor": "small_snow"
  },
  "122693": {
    "text": "日本に来てから十年になります。",
    "sourceAuthor": "small_snow"
  },
  "122696": {
    "text": "日本に来てどれくらいになりますか？",
    "sourceAuthor": "tommy_san"
  },
  "122731": {
    "text": "日本に来たのは初めてですか。",
    "sourceAuthor": "bunbuku"
  },
  "124249": {
    "text": "東京に住んでいます。",
    "sourceAuthor": "bunbuku"
  },
  "126710": {
    "text": "遅れてすみません。",
    "sourceAuthor": "small_snow"
  },
  "148465": {
    "text": "趣味は何ですか。",
    "sourceAuthor": "tommy__san"
  },
  "152203": {
    "text": "私もとても楽しかったです。",
    "sourceAuthor": "bunbuku"
  },
  "153093": {
    "text": "私は病院で働いています。",
    "sourceAuthor": "bunbuku"
  },
  "155923": {
    "text": "私は商社で働いています。",
    "sourceAuthor": "tommy__san"
  },
  "158373": {
    "text": "私は映画が好きです。",
    "sourceAuthor": "tommy_san"
  },
  "164201": {
    "text": "私のコーヒーには砂糖を入れないでください。",
    "sourceAuthor": "small_snow"
  },
  "164480": {
    "text": "私にも同じものをください。",
    "sourceAuthor": "bunbuku"
  },
  "169347": {
    "text": "散歩しませんか。",
    "sourceAuthor": "bunbuku"
  },
  "172084": {
    "text": "今度また誘ってよ。",
    "sourceAuthor": "bunbuku"
  },
  "172144": {
    "text": "今度の土曜日はどうですか。",
    "sourceAuthor": "bunbuku"
  },
  "175045": {
    "text": "元気？",
    "sourceAuthor": "bunbuku"
  },
  "175593": {
    "text": "月曜日は都合が悪いんです。",
    "sourceAuthor": "bunbuku"
  },
  "175785": {
    "text": "結構面白い。",
    "sourceAuthor": "small_snow"
  },
  "179494": {
    "text": "空いてる席はありますか。",
    "sourceAuthor": "bunbuku"
  },
  "179594": {
    "text": "銀行で働いています。",
    "sourceAuthor": "small_snow"
  },
  "184550": {
    "text": "覚えてる？",
    "sourceAuthor": "small_snow"
  },
  "185076": {
    "text": "海外には行ったことがありません。",
    "sourceAuthor": "small_snow"
  },
  "185455": {
    "text": "会えて嬉しいよ。",
    "sourceAuthor": "bunbuku"
  },
  "187448": {
    "text": "何時にどこで待ち合わせする？",
    "sourceAuthor": "bunbuku"
  },
  "187455": {
    "text": "何時にしましょうか。",
    "sourceAuthor": "small_snow"
  },
  "189286": {
    "text": "映画見に行かない？",
    "sourceAuthor": "mookeee"
  },
  "189297": {
    "text": "映画を見に行きませんか。",
    "sourceAuthor": "bunbuku"
  },
  "190532": {
    "text": "一緒に行かない？",
    "sourceAuthor": "bunbuku"
  },
  "190671": {
    "text": "一休みしませんか。",
    "sourceAuthor": "tommy_san"
  },
  "191216": {
    "text": "以上ですか？",
    "sourceAuthor": "small_snow"
  },
  "191499": {
    "text": "悪いけど行けないよ。",
    "sourceAuthor": "bunbuku"
  },
  "194081": {
    "text": "もう少し待ってください。",
    "sourceAuthor": "bunbuku"
  },
  "194123": {
    "text": "もう少しゆっくりお願いします。",
    "sourceAuthor": "small_snow"
  },
  "196236": {
    "text": "ホットドッグを２個、辛子とケチャップつきでおねがいします。",
    "sourceAuthor": "bunbuku"
  },
  "197456": {
    "text": "ビニール袋に入れてください。",
    "sourceAuthor": "small_snow"
  },
  "198336": {
    "text": "はい、とても好きです。",
    "sourceAuthor": "small_snow"
  },
  "198378": {
    "text": "はい、行きましょう。",
    "sourceAuthor": "small_snow"
  },
  "200548": {
    "text": "とても良かったです。また行きたいですね。",
    "sourceAuthor": "mookeee"
  },
  "200632": {
    "text": "とても楽しかったです。",
    "sourceAuthor": "small_snow"
  },
  "200771": {
    "text": "どちらのご出身ですか？",
    "sourceAuthor": "tommy_san"
  },
  "200777": {
    "text": "どちらにお住まいですか。",
    "sourceAuthor": "bunbuku"
  },
  "200952": {
    "text": "どこで待ち合わせしようか。",
    "sourceAuthor": "tommy_san"
  },
  "200953": {
    "text": "どこで待ち合わせしましょうか。",
    "sourceAuthor": "bunbuku"
  },
  "201705": {
    "text": "どういう意味ですか？",
    "sourceAuthor": "tommy_san"
  },
  "202713": {
    "text": "ちょっと無理ですね。",
    "sourceAuthor": "bunbuku"
  },
  "202737": {
    "text": "ちょっと待ってて。",
    "sourceAuthor": "small_snow"
  },
  "205018": {
    "text": "全部で三千円です。",
    "sourceAuthor": "KK_kaku_"
  },
  "213817": {
    "text": "そうは思いません。",
    "sourceAuthor": "Ianagisacos"
  },
  "214165": {
    "text": "もう一度お願いします。",
    "sourceAuthor": "bunbuku"
  },
  "214191": {
    "text": "すみません、通してください。",
    "sourceAuthor": "bunbuku"
  },
  "214201": {
    "text": "すみません、もう一度言っていただけますか。",
    "sourceAuthor": "tommy__san"
  },
  "214202": {
    "text": "すみません、もう一度ゆっくり言ってください。",
    "sourceAuthor": "bunbuku"
  },
  "214525": {
    "text": "スプーンをいただけますか。",
    "sourceAuthor": "bunbuku"
  },
  "214729": {
    "text": "すごいじゃん。",
    "sourceAuthor": "bunbuku"
  },
  "216819": {
    "text": "サッカーが一番好きです。",
    "sourceAuthor": "bunbuku"
  },
  "217064": {
    "text": "ご注文はお決まりですか？",
    "sourceAuthor": "tommy_san"
  },
  "217209": {
    "text": "ご一緒に食事でもしませんか。",
    "sourceAuthor": "bunbuku"
  },
  "222064": {
    "text": "この言葉はどういう意味ですか。",
    "sourceAuthor": "mookeee"
  },
  "224546": {
    "text": "ここで食べます。",
    "sourceAuthor": "Ianagisacos"
  },
  "224884": {
    "text": "コーヒーをください。",
    "sourceAuthor": "bunbuku"
  },
  "224907": {
    "text": "コーヒーにはミルクをたくさん入れて下さい。",
    "sourceAuthor": "bunbuku"
  },
  "226472": {
    "text": "カードは使えますか。",
    "sourceAuthor": "small_snow"
  },
  "226474": {
    "text": "カードでお願いします。",
    "sourceAuthor": "small_snow"
  },
  "226572": {
    "text": "お名前は？",
    "sourceAuthor": "bunbuku"
  },
  "226907": {
    "text": "お待たせしました。",
    "sourceAuthor": "bunbuku"
  },
  "226990": {
    "text": "お先にどうぞ。",
    "sourceAuthor": "bunbuku"
  },
  "227004": {
    "text": "お水をください。",
    "sourceAuthor": "bunbuku"
  },
  "227101": {
    "text": "お持ち帰りですか。",
    "sourceAuthor": "bunbuku"
  },
  "227125": {
    "text": "お仕事は何ですか。",
    "sourceAuthor": "bunbuku"
  },
  "227370": {
    "text": "お会計はレジでお願いします。",
    "sourceAuthor": "bunbuku"
  },
  "227376": {
    "text": "お会いできて嬉しいです。",
    "sourceAuthor": "bunbuku"
  },
  "227685": {
    "text": "おすすめの料理は何ですか。",
    "sourceAuthor": "bunbuku"
  },
  "227687": {
    "text": "おすすめは何ですか。",
    "sourceAuthor": "bunbuku"
  },
  "228005": {
    "text": "ええ、喜んで。",
    "sourceAuthor": "small_snow"
  },
  "228006": {
    "text": "ええ、わたしもそう思います。",
    "sourceAuthor": "bunbuku"
  },
  "228460": {
    "text": "いらっしゃいませ、何名様ですか。",
    "sourceAuthor": "small_snow"
  },
  "228624": {
    "text": "いつ都合がいいですか。",
    "sourceAuthor": "small_snow"
  },
  "229316": {
    "text": "いえ、結構です。",
    "sourceAuthor": "bunbuku"
  },
  "335372": {
    "text": "おはようございます。",
    "sourceAuthor": "Aurix"
  },
  "338114": {
    "text": "いらっしゃいませ。",
    "sourceAuthor": "shiboy"
  },
  "349070": {
    "text": "分かりません。",
    "sourceAuthor": "zipangu"
  },
  "373351": {
    "text": "こんにちは。",
    "sourceAuthor": "tommy_san"
  },
  "400933": {
    "text": "お元気ですか。",
    "sourceAuthor": "e4zh1nmcz"
  },
  "408295": {
    "text": "どういたしまして。",
    "sourceAuthor": "bunbuku"
  },
  "408301": {
    "text": "すみません。",
    "sourceAuthor": "bunbuku"
  },
  "417004": {
    "text": "久しぶりだね。",
    "sourceAuthor": "bunbuku"
  },
  "431679": {
    "text": "京都に行ったことありますか？",
    "sourceAuthor": "aliene"
  },
  "507553": {
    "text": "失礼します。",
    "sourceAuthor": "orzage"
  },
  "509772": {
    "text": "はい。",
    "sourceAuthor": "e4zh1nmcz"
  },
  "536751": {
    "text": "趣味は読書です。",
    "sourceAuthor": "tomkun01"
  },
  "605858": {
    "text": "まじで？",
    "sourceAuthor": "voodoo"
  },
  "628692": {
    "text": "本当だよ！",
    "sourceAuthor": "satosi"
  },
  "688395": {
    "text": "お疲れ様でした。",
    "sourceAuthor": "arihato"
  },
  "778160": {
    "text": "日本語がとても好きです。",
    "sourceAuthor": "windra"
  },
  "921333": {
    "text": "外国に行ったことがあります。",
    "sourceAuthor": "riccioberto"
  },
  "926739": {
    "text": "お願いします。",
    "sourceAuthor": "riccioberto"
  },
  "975671": {
    "text": "日本語を勉強しています。",
    "sourceAuthor": "ultrasaurus"
  },
  "1014812": {
    "text": "お会計お願いします。",
    "sourceAuthor": "mookeee"
  },
  "1022297": {
    "text": "すみません、注文お願いします。",
    "sourceAuthor": "mookeee"
  },
  "1035020": {
    "text": "いつかフランスに行ってみたいです。",
    "sourceAuthor": "bunbuku"
  },
  "1059896": {
    "text": "今日の夜、空いてる？",
    "sourceAuthor": "bunbuku"
  },
  "1064324": {
    "text": "ちょっと待って。",
    "sourceAuthor": "bunbuku"
  },
  "1125025": {
    "text": "旅行は好きですか？",
    "sourceAuthor": "mookeee"
  },
  "1166625": {
    "text": "うん。",
    "sourceAuthor": "bunbuku"
  },
  "1166626": {
    "text": "ええ。",
    "sourceAuthor": "bunbuku"
  },
  "1168408": {
    "text": "日本の食べ物を食べたことがありますか。",
    "sourceAuthor": "bunbuku"
  },
  "1189862": {
    "text": "私は日本語が少し話せますが、まだ上手じゃありません。",
    "sourceAuthor": "FiRez"
  },
  "1483688": {
    "text": "こちらへどうぞ。",
    "sourceAuthor": "marshmallowcat"
  },
  "1528157": {
    "text": "ローマに行ったことがあります。",
    "sourceAuthor": "bunbuku"
  },
  "1531875": {
    "text": "ありがとう！",
    "sourceAuthor": "cc_neko"
  },
  "1556116": {
    "text": "ごめん、忘れちゃった。",
    "sourceAuthor": "bunbuku"
  },
  "1614410": {
    "text": "コーヒーを一杯とクロワッサンをひとつ下さい。",
    "sourceAuthor": "Meow"
  },
  "1680694": {
    "text": "どうでしたか？",
    "sourceAuthor": "aka_aj"
  },
  "1937825": {
    "text": "大丈夫ですか。",
    "sourceAuthor": "agro1986"
  },
  "2041004": {
    "text": "楽しみにしています。",
    "sourceAuthor": "bunbuku"
  },
  "2137193": {
    "text": "ビールはあまり好きではありません。",
    "sourceAuthor": "bunbuku"
  },
  "2154940": {
    "text": "以上です。",
    "sourceAuthor": "bunbuku"
  },
  "2179000": {
    "text": "日本に行ったことがありますか。",
    "sourceAuthor": "abbymae111"
  },
  "2196376": {
    "text": "どうしたの。",
    "sourceAuthor": "bunbuku"
  },
  "2237943": {
    "text": "私の趣味は写真です。",
    "sourceAuthor": "tommy_san"
  },
  "2251469": {
    "text": "分かった。",
    "sourceAuthor": "DiePain"
  },
  "2265633": {
    "text": "お飲み物は何にしますか。",
    "sourceAuthor": "Ianagisacos"
  },
  "2304911": {
    "text": "大丈夫です。",
    "sourceAuthor": "bunbuku"
  },
  "2350395": {
    "text": "なるほど。",
    "sourceAuthor": "hutian"
  },
  "2374996": {
    "text": "見たことがあります。",
    "sourceAuthor": "wakatyann630"
  },
  "2436329": {
    "text": "六時はどうですか。",
    "sourceAuthor": "fgreco"
  },
  "2519008": {
    "text": "すみません、聞こえませんでした。",
    "sourceAuthor": "tommy_san"
  },
  "2569603": {
    "text": "起きてる？",
    "sourceAuthor": "tommy_san"
  },
  "2724966": {
    "text": "沖縄に行ったことはありますか？",
    "sourceAuthor": "tommy_san"
  },
  "2744751": {
    "text": "そうなんですか？",
    "sourceAuthor": "tommy_san"
  },
  "2929527": {
    "text": "すみません、何とおっしゃいましたか？",
    "sourceAuthor": "tommy_san"
  },
  "2976202": {
    "text": "読書がとても好きです。",
    "sourceAuthor": "Fukuko"
  },
  "3024516": {
    "text": "今週末は暇？",
    "sourceAuthor": "tommy_san"
  },
  "3126037": {
    "text": "明日楽しみだな。",
    "sourceAuthor": "tommy_san"
  },
  "3190694": {
    "text": "お仕事は何をなさってるんですか？",
    "sourceAuthor": "tommy_san"
  },
  "3190698": {
    "text": "お仕事は何をされているんですか？",
    "sourceAuthor": "tommy__san"
  },
  "3241575": {
    "text": "やばい、宿題やってない。",
    "sourceAuthor": "tommy_san"
  },
  "3247983": {
    "text": "今週末空いてる？",
    "sourceAuthor": "tommy_san"
  },
  "3262066": {
    "text": "タメでいいよ。",
    "sourceAuthor": "tommy_san"
  },
  "3326577": {
    "text": "会社員です。",
    "sourceAuthor": "boscowitch"
  },
  "3395375": {
    "text": "昨日何時に寝た？",
    "sourceAuthor": "tommy_san"
  },
  "3400864": {
    "text": "趣味は音楽鑑賞です。",
    "sourceAuthor": "tommy_san"
  },
  "3452051": {
    "text": "お勘定お願いします。",
    "sourceAuthor": "tommy_san"
  },
  "3452060": {
    "text": "今日の夜予定ある？",
    "sourceAuthor": "tommy_san"
  },
  "3495032": {
    "text": "元気です。",
    "sourceAuthor": "arnab"
  },
  "3495530": {
    "text": "冗談でしょ？",
    "sourceAuthor": "arnab"
  },
  "3507395": {
    "text": "分かりますか？",
    "sourceAuthor": "arnab"
  },
  "3515218": {
    "text": "ポイントカードはお持ちですか？",
    "sourceAuthor": "tommy_san"
  },
  "3580937": {
    "text": "私はエンジニアです。",
    "sourceAuthor": "e4zh1nmcz"
  },
  "3595025": {
    "text": "ご予約はされていますか？",
    "sourceAuthor": "arnab"
  },
  "3597438": {
    "text": "大きな声で言って。聞こえないよ。",
    "sourceAuthor": "arnab"
  },
  "3621802": {
    "text": "あっ、ごめんなさい。",
    "sourceAuthor": "arnab"
  },
  "3753221": {
    "text": "疲れちゃったの？",
    "sourceAuthor": "e4zh1nmcz"
  },
  "3878008": {
    "text": "手伝おうか？",
    "sourceAuthor": "tommy_san"
  },
  "4002020": {
    "text": "私もそう思います。",
    "sourceAuthor": "oliviya"
  },
  "4270214": {
    "text": "旅行はどうでしたか？",
    "sourceAuthor": "tommy_san"
  },
  "4562480": {
    "text": "もう一度言ってください。",
    "sourceAuthor": "Kiraness"
  },
  "4621452": {
    "text": "これは何ですか？",
    "sourceAuthor": "xDestroyerVx"
  },
  "4632701": {
    "text": "禁煙席をお願いします。",
    "sourceAuthor": "verbum"
  },
  "4694697": {
    "text": "何名様ですか。",
    "sourceAuthor": "wells"
  },
  "4751193": {
    "text": "旅行どうでしたか？",
    "sourceAuthor": "tommy_san"
  },
  "4751197": {
    "text": "どうでした、旅行は？",
    "sourceAuthor": "tommy_san"
  },
  "5762757": {
    "text": "何時に出る？",
    "sourceAuthor": "daifons"
  },
  "5955917": {
    "text": "そうですか。",
    "sourceAuthor": "tatoebane"
  },
  "5955920": {
    "text": "そうなんだ。",
    "sourceAuthor": "tatoebane"
  },
  "5955970": {
    "text": "とんでもありません！",
    "sourceAuthor": "tatoebane"
  },
  "6137181": {
    "text": "私は食べたことがありません。",
    "sourceAuthor": "Sethlang"
  },
  "8504258": {
    "text": "いいね。",
    "sourceAuthor": "kamojun"
  },
  "8576120": {
    "text": "紅茶をください。",
    "sourceAuthor": "small_snow"
  },
  "8583430": {
    "text": "これください。",
    "sourceAuthor": "bunbuku"
  },
  "8692850": {
    "text": "ソウルに住んでいます。",
    "sourceAuthor": "small_snow"
  },
  "8692860": {
    "text": "韓国人です。",
    "sourceAuthor": "small_snow"
  },
  "8795518": {
    "text": "ゆっくり話してください。",
    "sourceAuthor": "dotheduyet1999"
  },
  "8802478": {
    "text": "で、あなたは？",
    "sourceAuthor": "small_snow"
  },
  "8814342": {
    "text": "明日の夜って空いてる？",
    "sourceAuthor": "bunbuku"
  },
  "8842211": {
    "text": "明日は月曜だよね。",
    "sourceAuthor": "small_snow"
  },
  "8875105": {
    "text": "お茶でもどうですか？",
    "sourceAuthor": "small_snow"
  },
  "8886173": {
    "text": "少々お待ちください。",
    "sourceAuthor": "small_snow"
  },
  "8969092": {
    "text": "いつなら空いてる？",
    "sourceAuthor": "bunbuku"
  },
  "9041998": {
    "text": "語学学校で働いています。",
    "sourceAuthor": "Ninja"
  },
  "9043414": {
    "text": "どちらからいらしたんですか？",
    "sourceAuthor": "bunbuku"
  },
  "9046236": {
    "text": "観光で来てるんです。",
    "sourceAuthor": "bunbuku"
  },
  "9112549": {
    "text": "早いじゃん。",
    "sourceAuthor": "bunbuku"
  },
  "9203476": {
    "text": "こちらでお召し上がりですか？それともお持ち帰りですか？",
    "sourceAuthor": "bunbuku"
  },
  "9420495": {
    "text": "夜ご飯、食べに行かない？",
    "sourceAuthor": "bunbuku"
  },
  "9499960": {
    "text": "いいよ。",
    "sourceAuthor": "small_snow"
  },
  "9540499": {
    "text": "窓際の席でお願いします。",
    "sourceAuthor": "small_snow"
  },
  "9559301": {
    "text": "ありがとうございます。",
    "sourceAuthor": "Sim5634"
  },
  "9573232": {
    "text": "趣味は映画鑑賞です。",
    "sourceAuthor": "Sim5634"
  },
  "9681828": {
    "text": "コーヒーのお代わりをお願いします。",
    "sourceAuthor": "bunbuku"
  },
  "9699149": {
    "text": "はじめまして。",
    "sourceAuthor": "Sim5634"
  },
  "9776974": {
    "text": "金曜日はどうですか？",
    "sourceAuthor": "small_snow"
  },
  "9776980": {
    "text": "月曜日はどうですか？",
    "sourceAuthor": "small_snow"
  },
  "9961678": {
    "text": "今日の午後は空いてますか？",
    "sourceAuthor": "small_snow"
  },
  "9964582": {
    "text": "少し休憩しませんか？",
    "sourceAuthor": "small_snow"
  },
  "10000276": {
    "text": "その色いいね。",
    "sourceAuthor": "small_snow"
  },
  "10066792": {
    "text": "笑っちゃった。",
    "sourceAuthor": "small_snow"
  },
  "10089482": {
    "text": "北海道には一度、行ったことがあります。",
    "sourceAuthor": "small_snow"
  },
  "10100070": {
    "text": "ごちそうさまでした。",
    "sourceAuthor": "small_snow"
  },
  "10171381": {
    "text": "濡れちゃった。",
    "sourceAuthor": "small_snow"
  },
  "10455088": {
    "text": "駅で待ち合わせよう。",
    "sourceAuthor": "bunbuku"
  },
  "10455178": {
    "text": "駅で待ち合わせしようね。",
    "sourceAuthor": "small_snow"
  },
  "10574111": {
    "text": "コーヒー飲みに行かない？",
    "sourceAuthor": "small_snow"
  },
  "10602871": {
    "text": "待たせて、ごめんね。",
    "sourceAuthor": "small_snow"
  },
  "10605827": {
    "text": "もっと大きな声でお願いします。",
    "sourceAuthor": "small_snow"
  },
  "10607397": {
    "text": "麺類が好きです。",
    "sourceAuthor": "small_snow"
  },
  "10614923": {
    "text": "冗談だよね？",
    "sourceAuthor": "small_snow"
  },
  "10630194": {
    "text": "今夜は空いてるよ。",
    "sourceAuthor": "small_snow"
  },
  "10647275": {
    "text": "レシートをください。",
    "sourceAuthor": "small_snow"
  },
  "10657668": {
    "text": "ごめん、今は無理。",
    "sourceAuthor": "small_snow"
  },
  "10668790": {
    "text": "香港には一度行ったことがありますよ。",
    "sourceAuthor": "small_snow"
  },
  "10756859": {
    "text": "学生です。",
    "sourceAuthor": "small_snow"
  },
  "10899752": {
    "text": "はい、分かりました。",
    "sourceAuthor": "small_snow"
  },
  "10899840": {
    "text": "去年、友達と海外旅行に行きました。",
    "sourceAuthor": "small_snow"
  },
  "10901614": {
    "text": "ちょっと待ってください。",
    "sourceAuthor": "small_snow"
  },
  "10906691": {
    "text": "今何してる？",
    "sourceAuthor": "small_snow"
  },
  "10914856": {
    "text": "ええ、いいですよ。",
    "sourceAuthor": "small_snow"
  },
  "10918370": {
    "text": "どうぞよろしくお願いします。",
    "sourceAuthor": "small_snow"
  },
  "10952563": {
    "text": "綺麗だと思います。",
    "sourceAuthor": "small_snow"
  },
  "11001436": {
    "text": "えーとですね。",
    "sourceAuthor": "small_snow"
  },
  "11021618": {
    "text": "こちらこそ、はじめまして。",
    "sourceAuthor": "small_snow"
  },
  "11021619": {
    "text": "こちらこそ、よろしくお願いします。",
    "sourceAuthor": "small_snow"
  },
  "11054750": {
    "text": "飽きちゃった。",
    "sourceAuthor": "bunbuku"
  },
  "11062662": {
    "text": "お水のおかわりをお願いします。",
    "sourceAuthor": "bunbuku"
  },
  "11327855": {
    "text": "意味が分かりませんでした。",
    "sourceAuthor": "small_snow"
  },
  "11451491": {
    "text": "何時がご都合よろしいですか？",
    "sourceAuthor": "bunbuku"
  },
  "11488333": {
    "text": "こちらへはお仕事で？それとも観光ですか？",
    "sourceAuthor": "bunbuku"
  },
  "11512359": {
    "text": "知ってる？",
    "sourceAuthor": "megamanenm"
  },
  "11548105": {
    "text": "会計は別々でお願いします。",
    "sourceAuthor": "small_snow"
  },
  "11548108": {
    "text": "別々でお願いします。",
    "sourceAuthor": "small_snow"
  },
  "11735233": {
    "text": "とても美味しかったです。",
    "sourceAuthor": "small_snow"
  },
  "11744821": {
    "text": "月曜日は行けないんです。",
    "sourceAuthor": "bunbuku"
  },
  "12024147": {
    "text": "レシートはいりません。",
    "sourceAuthor": "small_snow"
  },
  "12221723": {
    "text": "海外旅行に行ったことはありますか？",
    "sourceAuthor": "small_snow"
  },
  "12304961": {
    "text": "何時がいい？",
    "sourceAuthor": "small_snow"
  },
  "12593262": {
    "text": "韓国で生まれました。",
    "sourceAuthor": "small_snow"
  },
  "12593296": {
    "text": "去年、初めてパリに行きました。",
    "sourceAuthor": "small_snow"
  },
  "12754558": {
    "text": "宿泊先はどうでしたか？",
    "sourceAuthor": "small_snow"
  },
  "12889995": {
    "text": "お名前は何ですか？",
    "sourceAuthor": "small_snow"
  },
  "12890046": {
    "text": "メニューをください。",
    "sourceAuthor": "small_snow"
  },
  "13117666": {
    "text": "申し訳ありません。",
    "sourceAuthor": "atitarev"
  },
  "13211669": {
    "text": "ううん。",
    "sourceAuthor": "atitarev"
  },
  "13254274": {
    "text": "音楽が大好きです。",
    "sourceAuthor": "atitarev"
  },
  "13254283": {
    "text": "音楽が好きです。",
    "sourceAuthor": "atitarev"
  },
  "13523728": {
    "text": "久しぶり！",
    "sourceAuthor": "LeviHighway"
  },
  "13640835": {
    "text": "いいですね。",
    "sourceAuthor": "6b"
  },
  "13714023": {
    "text": "領収書をください。",
    "sourceAuthor": "GreySquirrel"
  },
  "13753496": {
    "text": "日本が好きですか？",
    "sourceAuthor": "TanukiKun"
  },
  "13940407": {
    "text": "ホテルで働いています。",
    "sourceAuthor": "small_snow"
  },
  "14048807": {
    "text": "ナムと申します。",
    "sourceAuthor": "TanukiKun"
  }
}
