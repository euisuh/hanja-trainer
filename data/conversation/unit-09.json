{
  "units": [
    {
      "ord": 9,
      "titleKo": "좋아하는 것·경험·의견",
      "goalKo": "좋아하는 것, 가 본 곳이나 해 본 일, 간단한 의견과 감상을 말하고, 상대의 경험과 감상을 묻고 듣는다."
    }
  ],
  "chunks": [
    {
      "unitOrd": 9,
      "ord": 1,
      "text": "音楽が好きです。",
      "kana": "おんがくがすきです。",
      "cueKo": "좋아하는 것(음악)을 말하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #13254283",
      "audioKey": "c/31db6663cb32191b",
      "key": "tatoeba-13254283-say"
    },
    {
      "unitOrd": 9,
      "ord": 2,
      "text": "読書がとても好きです。",
      "kana": "どくしょがとてもすきです。",
      "cueKo": "독서를 아주 좋아한다고 말하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #2976202",
      "audioKey": "c/d19d043b2f8598fb",
      "key": "tatoeba-2976202-say"
    },
    {
      "unitOrd": 9,
      "ord": 3,
      "text": "私は映画が好きです。",
      "kana": "わたしはえいががすきです。",
      "cueKo": "영화를 좋아한다고 말하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #158373",
      "audioKey": "c/3e97a38fc64a83b6",
      "key": "tatoeba-158373-say"
    },
    {
      "unitOrd": 9,
      "ord": 4,
      "text": "麺類が好きです。",
      "kana": "めんるいがすきです。",
      "cueKo": "면 요리를 좋아한다고 말하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #10607397",
      "audioKey": "c/ddf5b43d8c815740",
      "key": "tatoeba-10607397-say"
    },
    {
      "unitOrd": 9,
      "ord": 5,
      "text": "日本語がとても好きです。",
      "kana": "にほんごがとてもすきです。",
      "cueKo": "일본어를 아주 좋아한다고 말하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #778160",
      "audioKey": "c/37e433a9bbd447c7",
      "key": "tatoeba-778160-say"
    },
    {
      "unitOrd": 9,
      "ord": 6,
      "text": "音楽が大好きです。",
      "kana": "おんがくがだいすきです。",
      "cueKo": "음악을 정말 좋아한다고 말하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #13254274",
      "audioKey": "c/f7e9f1c56dc01887",
      "key": "tatoeba-13254274-say"
    },
    {
      "unitOrd": 9,
      "ord": 7,
      "text": "サッカーが一番好きです。",
      "kana": "サッカーがいちばんすきです。",
      "cueKo": "축구를 가장 좋아한다고 말하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #216819",
      "audioKey": "c/24ecc3181c18e016",
      "key": "tatoeba-216819-say"
    },
    {
      "unitOrd": 9,
      "ord": 8,
      "text": "はい、とても好きです。",
      "kana": "はい、とてもすきです。",
      "cueKo": "좋아하냐는 질문에 아주 좋아한다고 답하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #198336",
      "audioKey": "c/e682e023b4027901",
      "key": "tatoeba-198336-say"
    },
    {
      "unitOrd": 9,
      "ord": 9,
      "text": "ビールはあまり好きではありません。",
      "kana": "ビールはあまりすきではありません。",
      "cueKo": "맥주는 별로 좋아하지 않는다고 말하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #2137193",
      "audioKey": "c/d9fc1316d8d9b9a9",
      "key": "tatoeba-2137193-say"
    },
    {
      "unitOrd": 9,
      "ord": 10,
      "text": "ローマに行ったことがあります。",
      "kana": "ローマにいったことがあります。",
      "cueKo": "로마에 가 본 적이 있다고 말하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #1528157",
      "audioKey": "c/62067e2dbe0463c7",
      "key": "tatoeba-1528157-say"
    },
    {
      "unitOrd": 9,
      "ord": 11,
      "text": "北海道には一度、行ったことがあります。",
      "kana": "ほっかいどうにはいちど、いったことがあります。",
      "cueKo": "홋카이도에 한 번 가 본 적이 있다고 말하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #10089482",
      "audioKey": "c/7ecda4e2cb7bde61",
      "key": "tatoeba-10089482-say"
    },
    {
      "unitOrd": 9,
      "ord": 12,
      "text": "外国に行ったことがあります。",
      "kana": "がいこくにいったことがあります。",
      "cueKo": "외국에 가 본 적이 있다고 말하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #921333",
      "audioKey": "c/2b2f6be8e15448db",
      "key": "tatoeba-921333-say"
    },
    {
      "unitOrd": 9,
      "ord": 13,
      "text": "海外には行ったことがありません。",
      "kana": "かいがいにはいったことがありません。",
      "cueKo": "해외에는 가 본 적이 없다고 말하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #185076",
      "audioKey": "c/5b4c30da53aa9b76",
      "key": "tatoeba-185076-say"
    },
    {
      "unitOrd": 9,
      "ord": 14,
      "text": "見たことがあります。",
      "kana": "みたことがあります。",
      "cueKo": "본 적이 있다고 답하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #2374996",
      "audioKey": "c/08fc4b0791c494ca",
      "key": "tatoeba-2374996-say"
    },
    {
      "unitOrd": 9,
      "ord": 15,
      "text": "私は食べたことがありません。",
      "kana": "わたしはたべたことがありません。",
      "cueKo": "먹어 본 적이 없다고 말하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #6137181",
      "audioKey": "c/f808ef3178dd4ea4",
      "key": "tatoeba-6137181-say"
    },
    {
      "unitOrd": 9,
      "ord": 16,
      "text": "去年、初めてパリに行きました。",
      "kana": "きょねん、はじめてパリにいきました。",
      "cueKo": "작년에 처음 파리에 갔다고 말하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #12593296",
      "audioKey": "c/930f386e194f8890",
      "key": "tatoeba-12593296-say"
    },
    {
      "unitOrd": 9,
      "ord": 17,
      "text": "去年、友達と海外旅行に行きました。",
      "kana": "きょねん、ともだちとかいがいりょこうにいきました。",
      "cueKo": "작년에 친구와 해외여행을 갔다고 말하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #10899840",
      "audioKey": "c/e8379e9566a73856",
      "key": "tatoeba-10899840-say"
    },
    {
      "unitOrd": 9,
      "ord": 18,
      "text": "とても楽しかったです。",
      "kana": "とてもたのしかったです。",
      "cueKo": "여행이 아주 즐거웠다고 말하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #200632",
      "audioKey": "c/1f78fc3dcd2b9f20",
      "key": "tatoeba-200632-say"
    },
    {
      "unitOrd": 9,
      "ord": 19,
      "text": "とても美味しかったです。",
      "kana": "とてもおいしかったです。",
      "cueKo": "음식이 아주 맛있었다고 말하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #11735233",
      "audioKey": "c/5c93447a8bc86942",
      "key": "tatoeba-11735233-say"
    },
    {
      "unitOrd": 9,
      "ord": 20,
      "text": "とても良かったです。また行きたいですね。",
      "kana": "とてもよかったです。またいきたいですね。",
      "cueKo": "아주 좋았고 또 가고 싶다고 말하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #200548",
      "audioKey": "c/1fdd4934a196d049",
      "key": "tatoeba-200548-say"
    },
    {
      "unitOrd": 9,
      "ord": 21,
      "text": "カレーはまあまあでした。",
      "kana": "カレーはまあまあでした。",
      "cueKo": "카레는 그저 그랬다고 말하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #76792",
      "audioKey": "c/f7dc3e68635f48d8",
      "key": "tatoeba-76792-say"
    },
    {
      "unitOrd": 9,
      "ord": 22,
      "text": "結構面白い。",
      "kana": "けっこうおもしろい。",
      "cueKo": "꽤 재미있다고 가볍게 말하기",
      "register": "casual",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #175785",
      "audioKey": "c/2be7a55e8a0be1b1",
      "key": "tatoeba-175785-say"
    },
    {
      "unitOrd": 9,
      "ord": 23,
      "text": "綺麗だと思います。",
      "kana": "きれいだとおもいます。",
      "cueKo": "예쁘다고 생각한다고 의견 말하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #10952563",
      "audioKey": "c/51ba8b4c4624af39",
      "key": "tatoeba-10952563-say"
    },
    {
      "unitOrd": 9,
      "ord": 24,
      "text": "私もそう思います。",
      "kana": "わたしもそうおもいます。",
      "cueKo": "상대 의견에 나도 그렇게 생각한다고 말하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #4002020",
      "audioKey": "c/0f8c093d899adb58",
      "key": "tatoeba-4002020-say"
    },
    {
      "unitOrd": 9,
      "ord": 25,
      "text": "そうは思いません。",
      "kana": "そうはおもいません。",
      "cueKo": "그렇게는 생각하지 않는다고 부드럽게 말하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #213817",
      "audioKey": "c/74fa2824f9ddee4e",
      "key": "tatoeba-213817-say"
    },
    {
      "unitOrd": 9,
      "ord": 26,
      "text": "いつかフランスに行ってみたいです。",
      "kana": "いつかフランスにいってみたいです。",
      "cueKo": "언젠가 프랑스에 가 보고 싶다고 말하기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #1035020",
      "audioKey": "c/03d430bc34fac456",
      "key": "tatoeba-1035020-say"
    },
    {
      "unitOrd": 9,
      "ord": 27,
      "text": "沖縄に行ったことはありますか？",
      "kana": "おきなわにいったことはありますか？",
      "cueKo": "상대에게 오키나와에 가 본 적 있냐고 묻기",
      "register": "polite",
      "role": "say",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #2724966",
      "audioKey": "c/e8c842d20055d6a7",
      "key": "tatoeba-2724966-say"
    },
    {
      "unitOrd": 9,
      "ord": 28,
      "text": "趣味は何ですか。",
      "kana": "しゅみはなんですか。",
      "cueKo": "상대가 취미가 뭐냐고 묻는 말 듣기",
      "register": "polite",
      "role": "hear",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #148465",
      "audioKey": "c/f0a9d432e7c61226",
      "key": "tatoeba-148465-hear"
    },
    {
      "unitOrd": 9,
      "ord": 29,
      "text": "旅行は好きですか？",
      "kana": "りょこうはすきですか？",
      "cueKo": "상대가 여행을 좋아하냐고 묻는 말 듣기",
      "register": "polite",
      "role": "hear",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #1125025",
      "audioKey": "c/7b98ab4104db1ab0",
      "key": "tatoeba-1125025-hear"
    },
    {
      "unitOrd": 9,
      "ord": 30,
      "text": "日本が好きですか？",
      "kana": "にほんがすきですか？",
      "cueKo": "상대가 일본을 좋아하냐고 묻는 말 듣기",
      "register": "polite",
      "role": "hear",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #13753496",
      "audioKey": "c/a35e9b8caa0c70ed",
      "key": "tatoeba-13753496-hear"
    },
    {
      "unitOrd": 9,
      "ord": 31,
      "text": "海外旅行に行ったことはありますか？",
      "kana": "かいがいりょこうにいったことはありますか？",
      "cueKo": "상대가 해외여행 경험을 묻는 말 듣기",
      "register": "polite",
      "role": "hear",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #12221723",
      "audioKey": "c/2d12ff04aa6ccd11",
      "key": "tatoeba-12221723-hear"
    },
    {
      "unitOrd": 9,
      "ord": 32,
      "text": "日本に行ったことがありますか。",
      "kana": "にほんにいったことがありますか。",
      "cueKo": "상대가 일본에 가 본 적 있냐고 묻는 말 듣기",
      "register": "polite",
      "role": "hear",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #2179000",
      "audioKey": "c/83935d85c2b7a5b0",
      "key": "tatoeba-2179000-hear"
    },
    {
      "unitOrd": 9,
      "ord": 33,
      "text": "京都に行ったことありますか？",
      "kana": "きょうとにいったことありますか？",
      "cueKo": "상대가 교토에 가 본 적 있냐고 묻는 말 듣기",
      "register": "polite",
      "role": "hear",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #431679",
      "audioKey": "c/721df0a6efa3dfe1",
      "key": "tatoeba-431679-hear"
    },
    {
      "unitOrd": 9,
      "ord": 34,
      "text": "日本の食べ物を食べたことがありますか。",
      "kana": "にほんのたべものをたべたことがありますか。",
      "cueKo": "상대가 일본 음식을 먹어 본 적 있냐고 묻는 말 듣기",
      "register": "polite",
      "role": "hear",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #1168408",
      "audioKey": "c/1b448be0511564e4",
      "key": "tatoeba-1168408-hear"
    },
    {
      "unitOrd": 9,
      "ord": 35,
      "text": "旅行はどうでしたか？",
      "kana": "りょこうはどうでしたか？",
      "cueKo": "상대가 여행이 어땠냐고 묻는 말 듣기",
      "register": "polite",
      "role": "hear",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #4270214",
      "audioKey": "c/054d1cfc205fb41d",
      "key": "tatoeba-4270214-hear"
    },
    {
      "unitOrd": 9,
      "ord": 36,
      "text": "旅行どうでしたか？",
      "kana": "りょこうどうでしたか？",
      "cueKo": "상대가 여행 어땠냐고 짧게 묻는 말 듣기",
      "register": "polite",
      "role": "hear",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #4751193",
      "audioKey": "c/b7efab93d677286c",
      "key": "tatoeba-4751193-hear"
    },
    {
      "unitOrd": 9,
      "ord": 37,
      "text": "どうでした、旅行は？",
      "kana": "どうでした、りょこうは？",
      "cueKo": "상대가 편하게 여행 어땠냐고 묻는 말 듣기",
      "register": "casual",
      "role": "hear",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #4751197",
      "audioKey": "c/4c1913ee9bffef45",
      "key": "tatoeba-4751197-hear"
    },
    {
      "unitOrd": 9,
      "ord": 38,
      "text": "どうでしたか？",
      "kana": "どうでしたか？",
      "cueKo": "상대가 어땠냐고 묻는 말 듣기",
      "register": "polite",
      "role": "hear",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #1680694",
      "audioKey": "c/f3ed826c36750448",
      "key": "tatoeba-1680694-hear"
    },
    {
      "unitOrd": 9,
      "ord": 39,
      "text": "宿泊先はどうでしたか？",
      "kana": "しゅくはくさきはどうでしたか？",
      "cueKo": "상대가 숙소는 어땠냐고 묻는 말 듣기",
      "register": "polite",
      "role": "hear",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #12754558",
      "audioKey": "c/4f8a7cfb93a17094",
      "key": "tatoeba-12754558-hear"
    },
    {
      "unitOrd": 9,
      "ord": 40,
      "text": "旅行は楽しかったですか。",
      "kana": "りょこうはたのしかったですか。",
      "cueKo": "상대가 여행이 즐거웠냐고 묻는 말 듣기",
      "register": "polite",
      "role": "hear",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #78157",
      "audioKey": "c/1f05f94e15e11715",
      "key": "tatoeba-78157-hear"
    },
    {
      "unitOrd": 9,
      "ord": 41,
      "text": "日本をどう思いますか。",
      "kana": "にほんをどうおもいますか。",
      "cueKo": "상대가 일본을 어떻게 생각하냐고 묻는 말 듣기",
      "register": "polite",
      "role": "hear",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #122379",
      "audioKey": "c/ee2f0ab28a4b3d6b",
      "key": "tatoeba-122379-hear"
    },
    {
      "unitOrd": 9,
      "ord": 42,
      "text": "ええ、わたしもそう思います。",
      "kana": "ええ、わたしもそうおもいます。",
      "cueKo": "상대가 나도 그렇게 생각한다고 맞장구치는 말 듣기",
      "register": "polite",
      "role": "hear",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #228006",
      "audioKey": "c/42307b0337639b04",
      "key": "tatoeba-228006-hear"
    },
    {
      "unitOrd": 9,
      "ord": 43,
      "text": "香港には一度行ったことがありますよ。",
      "kana": "ほんこんにはいちどいったことがありますよ。",
      "cueKo": "상대가 홍콩에 한 번 가 봤다고 하는 말 듣기",
      "register": "polite",
      "role": "hear",
      "sourceKind": "corpus",
      "sourceRef": "Tatoeba #10668790",
