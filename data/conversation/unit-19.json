      "authoredScope": "npc",
      "reviewNote": "Staff line, standard phrasing heard at this place. Authored for this app; no standalone Tatoeba sentence (GAPS.md, unit 19).",
      "audioKey": "c/18160c97d74f6a3f",
      "key": "authored-ec99880afd-hear"
    },
