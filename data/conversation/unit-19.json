      "register": "keigo",
      "role": "hear",
      "sourceKind": "authored",
      "authoredOn": "2026-11-06",
      "authoredScope": "npc",
      "reviewNote": "Staff line, standard phrasing heard at this place. Authored for this app; no standalone Tatoeba sentence (GAPS.md, unit 19).",
      "audioKey": "c/f99778f3b38ab884",
      "key": "authored-c7c04d3511-hear"
    },
    {
      "unitOrd": 19,
      "ord": 17,
      "text": "申し訳ございません、現金のみです。",
      "kana": "もうしわけございません、げんきんのみです。",
      "cueKo": "현금만 받는다는 정중한 대답 듣기",
      "register": "keigo",
      "role": "hear",
      "sourceKind": "authored",
      "authoredOn": "2026-11-06",
      "authoredScope": "npc",
      "reviewNote": "Staff line, standard phrasing heard at this place. Authored for this app; no standalone Tatoeba sentence (GAPS.md, unit 19).",
      "audioKey": "c/668733faed8b0b0a",
      "key": "authored-fd57d0b086-hear"
    },
    {
      "unitOrd": 19,
      "ord": 18,
      "text": "カードでお願いします。",
      "kana": "カードでおねがいします。",
      "cueKo": "카드로 부탁한다고 말하기",
      "register": "polite",
