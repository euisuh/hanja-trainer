      "key": "tatoeba-226474-say"
    },
    {
      "unitOrd": 19,
      "ord": 19,
      "text": "現金でお願いします。",
      "kana": "げんきんでおねがいします。",
      "cueKo": "현금으로 부탁한다고 말하기",
